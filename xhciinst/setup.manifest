<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  setup.manifest - SETUP.EXE runs as the invoker (design record 26 section
  2): Windows Vista and 7 would otherwise take a program named SETUP.EXE
  for an installer and ask for elevation before it starts. The window it
  starts asks for that itself. The compatibility section (Vista to 10, as
  XHCITR's) keeps Windows 7's Program Compatibility Assistant from asking
  "This program might not have installed correctly" when SETUP.EXE, taken
  for an installer by its name, ends having installed nothing itself
  (read on Windows 7, 2026-10-19). No Common Controls dependency: it draws
  nothing but a message box. Windows 98, ME and 2000 ignore it. Embedded
  by setup.rc as resource 1 of type 24 (RT_MANIFEST). ASCII only, CRLF
  line endings.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="3.2.0.0" processorArchitecture="*" name="xhci98.setup" type="win32"/>
  <description>xHCI98 Setup</description>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
