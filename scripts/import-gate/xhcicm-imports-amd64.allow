# xhcicm.sys import allowlist (amd64) - the Thunderbolt 3 connection
# manager's 64-bit build (roadmap-usb4.md task 39-A.1), held to NT 5.2 amd64
# evidence (winxp64-baselines.expected), as xhciuas-imports-amd64.allow holds
# xhciuas.sys. scripts\build-driver.cmd passes it with -AllowPath on every
# -amd64 link of src\cm. Format and rules: xhci98-imports.allow's header;
# the amd64 evidence rule: xhci98-imports-amd64.allow's.
#
# Every row is the amd64 twin of a row in xhcicm-imports.allow, except where
# the architecture changes the pair: KeInitializeSpinLock is an inline on
# amd64, and the Kf* spin-lock pair is KeAcquireSpinLockRaiseToDpc /
# KeReleaseSpinLock there; WDK 7.1's checked headers import RtlAssert (qemu
# only, debug having been retired with task 45.45); and /GS imports KeBugCheckEx, exactly as in
# xhci98-imports-amd64.allow, whose comments say why each is accepted. The
# SITES rules are the x86 file's. And three rows have no x86 twin: the NT
# handover's (task 46.12, design record 32 section 12.8.15), whose routines
# the x86 image, which loads on 98 SE and ME too, cannot import.

[imports]

# --- Compiler- and header-added pairs, as in xhci98-imports-amd64.allow ---
ntoskrnl.exe!KeBugCheckEx                  all    required  nt52-amd64-export; /GS __report_gsfailure only, bugcheck 0xF7 (as xhci98-imports-amd64.allow)
ntoskrnl.exe!RtlAssert                     qemu   required  nt52-amd64-export; WDK 7.1 checked-header ASSERTs only

# --- PnP: the NHI's FDO and the tunnel bridge's filter ---
ntoskrnl.exe!IoCreateDevice                all    required  nt52-amd64-export; twin of the x86 row
ntoskrnl.exe!IoDeleteDevice                all    required  nt52-amd64-export; twin of the x86 row
ntoskrnl.exe!IoAttachDeviceToDeviceStack   all    required  nt52-amd64-export; twin of the x86 row
ntoskrnl.exe!IoDetachDevice                all    required  nt52-amd64-export; twin of the x86 row
ntoskrnl.exe!IofCallDriver                 all    required  nt52-amd64-export; twin of the x86 row
ntoskrnl.exe!IofCompleteRequest            all    required  nt52-amd64-export; twin of the x86 row
ntoskrnl.exe!PoStartNextPowerIrp           all    required  nt52-amd64-export; twin of the x86 row
ntoskrnl.exe!PoCallDriver                  all    required  nt52-amd64-export; twin of the x86 row
ntoskrnl.exe!IoIsWdmVersionAvailable       all    required  nt52-amd64-export; twin of the x86 row
ntoskrnl.exe!IoGetDeviceProperty           all    required  nt52-amd64-export; twin of the x86 row

# --- The forwarded start and its wait ---
ntoskrnl.exe!KeInitializeEvent             all    required  nt52-amd64-export; twin of the x86 row
ntoskrnl.exe!KeSetEvent                    all    required  nt52-amd64-export; twin of the x86 row
ntoskrnl.exe!KeWaitForSingleObject         all    required  nt52-amd64-export; twin of the x86 row

# --- The tunnel ports and their re-enumeration (cm_reenum.c, tasks
# 39-A.5 and 39-A.8): configuration space of the tunnel ports through
# the HAL and the bridge filters' invalidation (the resume hold's
# timer rows went with the hold, task 43.24h). Each row is xhci98.sys's
# own, its evidence verbatim. ---
ntoskrnl.exe!IoInvalidateDeviceRelations   all  required  nt52-amd64-export; twin of the x86 row (task 26-A.4)
HAL.dll!HalGetBusData                     all  required  nt52-amd64-export; twin of the x86 row (task 36.3); also in WDK 7.1's wlh and win7 amd64 hal.lib

# --- The log ring's lock (cm_log.c) ---
ntoskrnl.exe!KeAcquireSpinLockRaiseToDpc   all    required  nt52-amd64-export; KeAcquireSpinLock/KeReleaseSpinLock on amd64 (the x86 HAL.dll Kf* rows)
ntoskrnl.exe!KeReleaseSpinLock             all    required  nt52-amd64-export; KeAcquireSpinLock/KeReleaseSpinLock on amd64 (the x86 HAL.dll Kf* rows)

# --- The registry values: cm_reg.obj only ---
ntoskrnl.exe!IoOpenDeviceRegistryKey       all    required  SITES=cm_reg.obj,cm_statos.obj nt52-amd64-export; twin of the x86 row
ntoskrnl.exe!RtlQueryRegistryValues        all    required  SITES=cm_reg.obj,cm_statos.obj nt52-amd64-export; twin of the x86 row
ntoskrnl.exe!ZwClose                       all    required  SITES=cm_reg.obj,cm_thr.obj,cm_statos.obj nt52-amd64-export; twin of the x86 row

# --- The log's emission, every flavour (record 21 section 8): cm_log.obj ---
ntoskrnl.exe!DbgPrint                      all    required  SITES=cm_log.obj nt52-amd64-export; twin of the x86 row

# --- Pool: cm_pool.obj only (CmAlloc, CmFree), required as on x86 ---
ntoskrnl.exe!ExAllocatePoolWithTag         all    required  SITES=cm_pool.obj nt52-amd64-export; twin of the x86 row
ntoskrnl.exe!ExFreePool                    all    required  SITES=cm_pool.obj nt52-amd64-export; twin of the x86 row

# --- The NHI driver of task 39-A.4: BAR0, configuration space, the
# thread and its clock, the power policy owner, the ring block's
# adapter (cm_pool.obj only). Each row is xhci98.sys's own, its
# evidence text verbatim but for the SITES object. ---
ntoskrnl.exe!PoSetPowerState               all  required  nt52-amd64-export; twin of the x86 row (task 26-A.1)
ntoskrnl.exe!IoAllocateIrp                 all  required  nt52-amd64-export; twin of the x86 row (task 26-A.2)
ntoskrnl.exe!IoFreeIrp                     all  required  nt52-amd64-export; twin of the x86 row (task 26-A.2)
ntoskrnl.exe!KeClearEvent                  all  required  nt52-amd64-export; twin of the x86 row (task 26-A.2)
ntoskrnl.exe!KeDelayExecutionThread        all  required  nt52-amd64-export; twin of the x86 row (task 26-A.2)
ntoskrnl.exe!MmMapIoSpace                  all  required  nt52-amd64-export; twin of the x86 row (task 26-A.2)
ntoskrnl.exe!MmUnmapIoSpace                all  required  nt52-amd64-export; twin of the x86 row (task 26-A.2)
ntoskrnl.exe!PoRequestPowerIrp             all  required  nt52-amd64-export; twin of the x86 row (task 26-A.2)
ntoskrnl.exe!PsCreateSystemThread          all  required  nt52-amd64-export; twin of the x86 row (task 26-A.2)
ntoskrnl.exe!PsTerminateSystemThread       all  required  nt52-amd64-export; twin of the x86 row (task 26-A.2)
ntoskrnl.exe!ObReferenceObjectByHandle    all  required  nt52-amd64-export; twin of the x86 row (task 26-A.2)
ntoskrnl.exe!ObfDereferenceObject         all  required  nt52-amd64-export; twin of the x86 row (task 26-A.2)
ntoskrnl.exe!IoGetDmaAdapter               all  required  SITES=cm_pool.obj nt52-amd64-export; twin of the x86 row (task 26-A.2)
HAL.dll!KeStallExecutionProcessor          all  required  nt52-amd64-export; twin of the x86 row (task 26-A.2)
ntoskrnl.exe!KeQueryTimeIncrement          all  required  nt52-amd64-export; the clock's tick period (cm_thr.c); KeQueryTickCount is inline on amd64
# The stor98 link-state channel (cm_nvlinkos.c; tasks 39-A.7 and 40-A.7).
ntoskrnl.exe!ExCreateCallback              all    required  SITES=cm_nvlinkos.obj nt52-amd64-export; twin of the x86 row
ntoskrnl.exe!ExRegisterCallback            all    required  SITES=cm_nvlinkos.obj nt52-amd64-export; twin of the x86 row
ntoskrnl.exe!ExUnregisterCallback          all    required  SITES=cm_nvlinkos.obj nt52-amd64-export; twin of the x86 row

# --- the status record (cm_statos.c, design record 24 section 3.2);
# KeQuerySystemTime is inline on amd64 ---
ntoskrnl.exe!ZwSetValueKey                 all    required  SITES=cm_statos.obj nt52-amd64-export; twin of the x86 row
ntoskrnl.exe!RtlInitUnicodeString          all    required  SITES=cm_statos.obj nt52-amd64-export; twin of the x86 row
# The boot guard's marker (record 32 section 12.8.15.13): flushed after
# its write and its delete. No x86 twin.
ntoskrnl.exe!ZwFlushKey                    all    required  SITES=cm_statos.obj nt52-amd64-export; task 46.12, the boot guard's marker persisted
ntoskrnl.exe!ZwDeleteValueKey              all    required  SITES=cm_statos.obj nt52-amd64-export; task 46.12, the boot guard's marker cleared

# --- Routines found at run time, no x86 twin (the x86 file refuses
# MmGetSystemRoutineAddress for Windows 98; the x86 image asks the
# helper's channel instead). One caller: cm_oscnt.c, CmRoutine (record 32
# section 12.8.15.15), for the NT handover (RtlGetVersion, IoWMIOpenBlock
# and IoWMIQueryAllData) and for the ACPI-named tunnel-port source
# (cm_dsdos.c, task 46.23, design record 22 section 7.6.1:
# IoGetDevicePropertyData for the NHI's own ACPI name) ---
ntoskrnl.exe!MmGetSystemRoutineAddress     all    required  SITES=cm_oscnt.obj nt52-amd64-export; task 46.12, the NT handover's routines looked up (CmRoutine); task 46.23, the NHI's ACPI name through CmRoutine (record 22 section 7.6.1)

# --- the query device (cm_qryos.c, design record 25 section 4.2) ---
ntoskrnl.exe!IoCreateSymbolicLink          all    required  nt52-amd64-export; twin of the x86 row
ntoskrnl.exe!IoDeleteSymbolicLink          all    required  nt52-amd64-export; twin of the x86 row
ntoskrnl.exe!IoRegisterDeviceInterface     all    required  nt52-amd64-export; twin of the x86 row

# --- the ring interrupt (cm_rirqos.c, design record 21 section 4.5.8) ---
ntoskrnl.exe!IoConnectInterrupt            all    required  nt52-amd64-export; twin of the x86 row (task 45.22)
ntoskrnl.exe!IoDisconnectInterrupt         all    required  nt52-amd64-export; twin of the x86 row (task 45.22)
ntoskrnl.exe!KeInitializeDpc               all    required  nt52-amd64-export; twin of the x86 row (task 45.22)
ntoskrnl.exe!KeInsertQueueDpc              all    required  nt52-amd64-export; twin of the x86 row (task 45.22)
ntoskrnl.exe!KeSynchronizeExecution        all    required  nt52-amd64-export; twin of the x86 row (task 45.22)

# --- Thunderbolt networking (cm_net.c, design record 35, task 45.59) ---
ntoskrnl.exe!KeInitializeTimer             all    required  nt52-amd64-export; twin of the x86 row (task 45.59)
ntoskrnl.exe!KeSetTimer                    all    required  nt52-amd64-export; twin of the x86 row (task 45.59)
ntoskrnl.exe!KeCancelTimer                 all    required  nt52-amd64-export; twin of the x86 row (task 45.59)
ntoskrnl.exe!ObfReferenceObject            all    required  nt52-amd64-export; twin of the x86 row (task 45.59)
ntoskrnl.exe!ExQueueWorkItem               all    required  SITES=cm_filt.obj,cm_reenum.obj nt52-amd64-export; twin of the x86 row (task 48.29); task 49.46, cm_reenum.obj: named only in the wake power-up's route R2, which is not compiled (CM_WPU_R2_BUILT 0, design record 21 section 6.3.1); the site is here because these objects are LTCG and the rule is checked on the source text, while the x86 row, checked on the objects, keeps cm_filt.obj alone

[deny]

ExAllocatePool              Not the HCD's spelling (xhci98-imports.allow; task 25.3). Allocate with ExAllocatePoolWithTag.
ExFreePoolWithTag           No Windows 98 evidence, and the x86 and amd64 sources are one tree: free with ExFreePool on both.
IoForwardIrpSynchronously   Windows XP and later - blocks the load on Win2000, and the x86 and amd64 sources are one tree. Use IoCallDriver plus a completion routine that signals a KEVENT.
IoSetCompletionRoutineEx    Windows XP and later - blocks the load on Win2000, as above.
IoCsqInitialize             Cancel-safe queues arrived with the XP DDK and are not in the Win2K DDK's libraries.
IoCsqInsertIrp              Cancel-safe queue family - not in the Win2K DDK.
IoCsqRemoveNextIrp          Cancel-safe queue family - not in the Win2K DDK.
