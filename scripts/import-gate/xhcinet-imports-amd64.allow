# xhcinet.sys import allowlist (amd64) - the NDIS 5.1 miniport of Thunderbolt
# networking for XP x64, Server 2003 x64, Vista x64 and 7 x64 (design record
# 35 section 7.1, roadmap-usb4.md task 45.59 step S6), WDK 7.1 WNET.
# scripts\import-gate\check-imports.ps1 enforces it (the default amd64 rules:
# every NTOSKRNL.EXE pair re-derived against NT 5.2 amd64's export tables,
# xhci98-imports-amd64.allow's header). NDIS.SYS pairs: NT 5.2 amd64's ndis.sys
# is not among the staged baselines, so they are held to this list; the
# XP x64 and 7 x64 legs read the load (record 35 section 11.3).

[imports]

ntoskrnl.exe!KeBugCheckEx                    all  required  nt52-amd64-export; /GS __report_gsfailure only, bugcheck 0xF7 (as xhci98-imports-amd64.allow)
ntoskrnl.exe!ObfDereferenceObject            all  required  nt52-amd64-export
ntoskrnl.exe!ObReferenceObjectByHandle       all  required  nt52-amd64-export
ntoskrnl.exe!ZwClose                         all  required  nt52-amd64-export
ntoskrnl.exe!PsTerminateSystemThread         all  required  nt52-amd64-export
ntoskrnl.exe!PsCreateSystemThread            all  required  nt52-amd64-export
ntoskrnl.exe!KeClearEvent                    all  required  nt52-amd64-export
ntoskrnl.exe!KeAcquireSpinLockRaiseToDpc     all  required  nt52-amd64-export; NdisAcquireSpinLock and NdisReleaseSpinLock are these on amd64
ntoskrnl.exe!IoFreeMdl                       all  required  nt52-amd64-export; NdisQueryBuffer and NdisFreeBuffer are these on amd64
ntoskrnl.exe!KeReleaseSpinLock               all  required  nt52-amd64-export; NdisAcquireSpinLock and NdisReleaseSpinLock are these on amd64
ntoskrnl.exe!MmMapLockedPages                all  required  nt52-amd64-export; NdisQueryBuffer and NdisFreeBuffer are these on amd64
ntoskrnl.exe!IofCallDriver                   all  required  nt52-amd64-export
ntoskrnl.exe!IoAllocateIrp                   all  required  nt52-amd64-export
ntoskrnl.exe!IoFreeIrp                       all  required  nt52-amd64-export
ntoskrnl.exe!KeWaitForSingleObject           all  required  nt52-amd64-export
ntoskrnl.exe!KeInitializeEvent               all  required  nt52-amd64-export
ntoskrnl.exe!KeSetEvent                      all  required  nt52-amd64-export
ntoskrnl.exe!RtlAssert                       qemu optional  nt52-amd64-export; WDK 7.1 checked-header ASSERTs only
NDIS.SYS!NdisAllocatePacket                  all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
NDIS.SYS!NdisMGetDeviceProperty              all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
NDIS.SYS!NdisReadConfiguration               all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
NDIS.SYS!NdisTerminateWrapper                all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
NDIS.SYS!NdisMSetAttributesEx                all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
NDIS.SYS!NdisInitializeWrapper               all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
NDIS.SYS!NdisMRegisterMiniport               all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
NDIS.SYS!NdisCloseConfiguration              all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
NDIS.SYS!NdisOpenConfiguration               all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
NDIS.SYS!NdisAllocateBuffer                  all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
NDIS.SYS!NdisFreeBufferPool                  all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
NDIS.SYS!NdisAllocateMemory                  all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
NDIS.SYS!NdisAllocateBufferPool              all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
NDIS.SYS!NdisUnchainBufferAtFront            all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
NDIS.SYS!NdisAllocatePacketPool              all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
NDIS.SYS!NdisFreeMemory                      all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
NDIS.SYS!NdisMIndicateStatus                 all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
NDIS.SYS!NdisMIndicateStatusComplete         all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
NDIS.SYS!NdisMSleep                          all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
NDIS.SYS!NdisFreePacket                      all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
NDIS.SYS!NdisFreePacketPool                  all  required  NDIS 5.1 export on NT 5.2 and 6.x amd64; the legs read it
