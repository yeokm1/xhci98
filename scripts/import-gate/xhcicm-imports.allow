# xhcicm.sys import allowlist (x86) - module/symbol pairs the Thunderbolt 3
# connection manager may import (roadmap-usb4.md task 39-A.1; design record
# 21 section 10.3). scripts\build-driver.cmd runs
# scripts\import-gate\check-imports.ps1 with -AllowPath naming this file on
# every link of src\cm, so the third binary of the package is gated as the
# first two are: the same format, the same three evidence tags, the same rule
# that every row carries Windows 98 evidence of its own, and the same deny
# set. See xhci98-imports.allow's header for the format and the rules; this
# header says only what differs.
#
# EVERY ROW IS A PAIR xhci98.sys ALREADY IMPORTS, with that file's evidence
# text verbatim (record 21 section 10.3: the driver adds no pair the HCD has
# no evidence for). No pair here is new to the evidence base.
#
# SITES. The pool pair is held to cm_pool.obj (the HCD's rule of design
# record 13 section 7.5, as uas_mem.obj holds xhciuas.sys's), and is
# OPTIONAL while nothing allocates pool (the NHI's state is its device
# extension; task 39-A.4): nothing allocates, and ExFreePool is called
# only for the bus driver's IRP_MN_QUERY_ID answer (cm_qryos.c). The registry pairs are held to cm_reg.obj, and to cm_statos.obj for the
# install tool's status record (design record 24). DbgPrint is
# held to cm_log.obj and to the debug and qemu flavours (decision D12: the
# release flavour prints nothing, as xhciuas.sys prints nothing), which keeps
# AGENTS.md's two-site rule for an unguarded DbgPrint as it is: this one is
# under #if DBG.
#
# No USBPORT.SYS or USBD.SYS pair: the driver is not a USB driver.
#
# Format, one entry per line, whitespace separated:
#
#   MODULE!SYMBOL   FLAVORS   REQUIREMENT   evidence notes to end of line

[imports]

# --- PnP: the NHI's FDO and the tunnel bridge's filter ---
ntoskrnl.exe!IoCreateDevice                  all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!IoCreateDevice, hint 38) (+43 other 98 SE); ntkern-name
ntoskrnl.exe!IoDeleteDevice                  all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!IoDeleteDevice, hint 3D) (+41 other 98 SE); ntkern-name
ntoskrnl.exe!IoAttachDeviceToDeviceStack     all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!IoAttachDeviceToDeviceStack, hint 30) (+36 other 98 SE); ntkern-name
ntoskrnl.exe!IoDetachDevice                  all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!IoDetachDevice, hint 3F) (+26 other 98 SE); ntkern-name
ntoskrnl.exe!IofCallDriver                   all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!IofCallDriver, hint 68) (+49 other 98 SE); ntkern-name
ntoskrnl.exe!IofCompleteRequest              all  required  w2k-export; win98-precedent usbhub.sys 4.10.2222 (NTOSKRNL.EXE!IofCompleteRequest, hint 69) (+43 other 98 SE); ntkern-name
ntoskrnl.exe!PoStartNextPowerIrp             all  required  w2k-export; win98-precedent usbhub.sys 4.10.2222 (NTOSKRNL.EXE!PoStartNextPowerIrp, hint B6) (+25 other 98 SE); ntkern-name
ntoskrnl.exe!PoCallDriver                    all  required  w2k-export; win98-precedent usbhub.sys 4.10.2222 (NTOSKRNL.EXE!PoCallDriver, hint AE) (+21 other 98 SE); ntkern-name
# The role: Windows 98 SE and ME have the NHI role alone (cm_entry.c).
ntoskrnl.exe!IoIsWdmVersionAvailable        all  required  w2k-export; win98-precedent ohci1394.sys 4.10.2222 (NTOSKRNL.EXE!IoIsWdmVersionAvailable, hint 51) (Appendix A row 40); NUSB USBPORT.SYS 5.00.2195.5652 (hint 55). Chooses the role: (1, 0x10) is TRUE from Windows 2000 (WDM 1.10) on and FALSE on 98 (1.00) and ME (1.05)
# The PDO's hardware ids, read on the NT targets only (cm_entry.c).
ntoskrnl.exe!IoGetDeviceProperty             all  required  w2k-export; win98-precedent usbhub.sys 4.10.2222 (NTOSKRNL.EXE!IoGetDeviceProperty, hint 49) (+7 other 98 SE); ntkern-name

# --- The filter's count of device-usage notifications in flight (cm_filt.c) ---
ntoskrnl.exe!InterlockedIncrement            all  required  w2k-export; win98-precedent openhci.sys 4.10.2222 (NTOSKRNL.EXE!InterlockedIncrement, hint 28) (+35 other 98 SE); ntkern-name
ntoskrnl.exe!InterlockedDecrement           all  required  w2k-export; win98-precedent openhci.sys 4.10.2222 (NTOSKRNL.EXE!InterlockedDecrement, hint 26) (+33 other 98 SE); ntkern-name

# --- The forwarded start and its wait ---
ntoskrnl.exe!KeInitializeEvent               all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!KeInitializeEvent, hint 74) (+48 other 98 SE); ntkern-name
ntoskrnl.exe!KeSetEvent                      all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!KeSetEvent, hint 8E) (+42 other 98 SE); ntkern-name
ntoskrnl.exe!KeWaitForSingleObject           all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!KeWaitForSingleObject, hint 95) (+51 other 98 SE); ntkern-name

# --- The tunnel ports and their re-enumeration (cm_reenum.c, tasks
# 39-A.5 and 39-A.8): configuration space of the tunnel ports through
# the HAL, the bridge filters' invalidation, and the resume hold's
# watchdog. Each row is xhci98.sys's own, its evidence verbatim. ---
ntoskrnl.exe!KeInitializeDpc                 all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!KeInitializeDpc, hint 73) (+24 other 98 SE)
ntoskrnl.exe!KeInitializeTimer               all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!KeInitializeTimer, hint 78) (+20 other 98 SE)
ntoskrnl.exe!KeSetTimer                      all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!KeSetTimer, hint 90) (+18 other 98 SE)
ntoskrnl.exe!KeCancelTimer                   all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!KeCancelTimer, hint 6D) (+20 other 98 SE)
ntoskrnl.exe!IoInvalidateDeviceRelations     all  required  w2k-export; win98-precedent usbhub.sys 4.10.2222 (NTOSKRNL.EXE!IoInvalidateDeviceRelations, hint 4F) (+3 other 98 SE); ntkern-name
HAL.dll!HalGetBusData                       all  required  w2k-export; ntkern-name (ntkern.vxd's hal.dll name block, beside KfAcquireSpinLock; legal-provenance.md section 4); task 36.3, 00:14.0 and 00:1F.0 read from offset 0

# --- The log ring's lock (cm_log.c) ---
ntoskrnl.exe!KeInitializeSpinLock            all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!KeInitializeSpinLock, hint 77) (+32 other 98 SE); ntkern-name
HAL.dll!KfAcquireSpinLock                    all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (HAL.DLL!KfAcquireSpinLock, hint 6) (+31 other 98 SE); ntkern-name
HAL.dll!KfReleaseSpinLock                    all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (HAL.DLL!KfReleaseSpinLock, hint 9) (+31 other 98 SE); ntkern-name

# --- The registry values of record 21 section 8: cm_reg.obj only ---
ntoskrnl.exe!IoOpenDeviceRegistryKey         all  required  SITES=cm_reg.obj,cm_statos.obj w2k-export; win98-precedent usbhub.sys 4.10.2222 (NTOSKRNL.EXE!IoOpenDeviceRegistryKey, hint 53) (+18 other 98 SE); ntkern-name
ntoskrnl.exe!RtlQueryRegistryValues          all  required  SITES=cm_reg.obj,cm_statos.obj w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!RtlQueryRegistryValues, hint DA) (+8 other 98 SE); ntkern-name
ntoskrnl.exe!ZwClose                         all  required  SITES=cm_reg.obj,cm_thr.obj,cm_cfgwk.obj,cm_statos.obj w2k-export; win98-precedent usbhub.sys 4.10.2222 (NTOSKRNL.EXE!ZwClose, hint EF) (+29 other 98 SE); ntkern-name

# --- The log's emission, checked flavours only (decision D12): cm_log.obj ---
ntoskrnl.exe!DbgPrint                        debug  required  SITES=cm_log.obj the #if DBG emit at stop; w2k-export; win98-precedent ks.sys 4.10.2222 (NTOSKRNL.EXE!DbgPrint, hint 1) (+1 other 98 SE); ntkern-name (design record 13 section 7.4)
ntoskrnl.exe!DbgPrint                        qemu   required  SITES=cm_log.obj the #if DBG emit at stop; w2k-export; win98-precedent ks.sys 4.10.2222 (NTOSKRNL.EXE!DbgPrint, hint 1) (+1 other 98 SE); ntkern-name (design record 13 section 7.4)
# --- The qemu flavour's port-0xE9 mirror of that emission, never published ---
HAL.dll!WRITE_PORT_UCHAR                     qemu   required  SITES=cm_log.obj w2k-export; ntkern-name; MEASURED NOT LOADING on E460 Win98 SE metal (the miniport's allowlist on branch 1.2.0.0 has the record; design record 08). The qemu flavour is never published, so this row is what keeps the import out of every binary a user can install.

# --- Pool: cm_pool.obj only, optional while nothing allocates pool ---
ntoskrnl.exe!ExAllocatePoolWithTag           all  optional  SITES=cm_pool.obj w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!ExAllocatePoolWithTag, hint 7) (+61 other 98 SE); ntkern-name
ntoskrnl.exe!ExFreePool                      all  optional  SITES=cm_pool.obj w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!ExFreePool, hint C) (+60 other 98 SE); ntkern-name

# --- The NHI driver of task 39-A.4: BAR0, configuration space, the
# thread and its clock, the power policy owner, the ring block's
# adapter (cm_pool.obj only). Each row is xhci98.sys's own, its
# evidence text verbatim but for the SITES object. ---
ntoskrnl.exe!PoSetPowerState                 all  required  w2k-export; win98-precedent usbd.sys 4.10.2222 (NTOSKRNL.EXE!PoSetPowerState, hint B4) (+5 other 98 SE); ntkern-name
ntoskrnl.exe!PoRequestPowerIrp               all  required  w2k-export; win98-precedent usbhub.sys 4.10.2222 (NTOSKRNL.EXE!PoRequestPowerIrp, hint B3) (+14 other 98 SE); ntkern-name
ntoskrnl.exe!MmMapIoSpace                    all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!MmMapIoSpace, hint 9C) (+7 other 98 SE); ntkern-name
ntoskrnl.exe!MmUnmapIoSpace                  all  required  w2k-export; win98-precedent acpi.sys 4.10.2222 (NTOSKRNL.EXE!MmUnmapIoSpace, hint A6) (+5 other 98 SE); ntkern-name
ntoskrnl.exe!READ_REGISTER_ULONG             all  required  w2k-export; win98-precedent openhci.sys 4.10.2222 (NTOSKRNL.EXE!READ_REGISTER_ULONG, hint C0) (+3 other 98 SE); ntkern-name
ntoskrnl.exe!WRITE_REGISTER_ULONG            all  required  w2k-export; win98-precedent openhci.sys 4.10.2222 (NTOSKRNL.EXE!WRITE_REGISTER_ULONG, hint ED) (+3 other 98 SE); ntkern-name
ntoskrnl.exe!IoGetDmaAdapter                 all  required  SITES=cm_pool.obj the ring block's one adapter call (record 21 section 4.2); w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!IoGetDmaAdapter, hint 4A) (+6 other 98 SE); ntkern-name
ntoskrnl.exe!IoAllocateIrp                   all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!IoAllocateIrp, hint 2D) (+30 other 98 SE); ntkern-name
ntoskrnl.exe!IoFreeIrp                       all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!IoFreeIrp, hint 42) (+31 other 98 SE); ntkern-name
ntoskrnl.exe!KeClearEvent                    all  required  w2k-export; win98-precedent ks.sys 4.10.2222 (NTOSKRNL.EXE!KeClearEvent, hint 6E) (+5 other 98 SE); ntkern-name
ntoskrnl.exe!KeDelayExecutionThread          all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!KeDelayExecutionThread, hint 6F) (+12 other 98 SE); ntkern-name
# The thread's millisecond clock (cm_thr.c; record 22 section 5): the tick
# count, monotonic, never the system time. KeQueryTickCount is an x86
# macro reading this DATA export.
ntoskrnl.exe!KeTickCount                     all  required  w2k-export; win98-precedent battc.sys 4.10.2222 (NTOSKRNL.EXE!KeTickCount, hint 93) (design record 13 Appendix A); the data export KeQueryTickCount reads
ntoskrnl.exe!KeQueryTimeIncrement            all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!KeQueryTimeIncrement, hint 81) (+5 other 98 SE); ntkern-name
HAL.dll!KeGetCurrentIrql                     all  required  w2k-export; win98-precedent uhcd.sys 4.10.2222 (HAL.DLL!KeGetCurrentIrql, hint 3) (+15 other 98 SE)
HAL.dll!KeStallExecutionProcessor            all  required  w2k-export; win98-precedent openhci.sys 4.10.2222 (HAL.DLL!KeStallExecutionProcessor, hint 5) (+15 other 98 SE); ntkern-name
ntoskrnl.exe!PsCreateSystemThread            all  required  w2k-export; win98-precedent bt829.sys 4.10.2222 (NTOSKRNL.EXE!PsCreateSystemThread, hint BA); NUSB USBPORT.SYS 5.00.2195.5652 (hint C1) (design record 13 Appendix A row 112). The controller thread (section 5.4)
ntoskrnl.exe!PsTerminateSystemThread         all  required  w2k-export; win98-precedent bt829.sys 4.10.2222 (NTOSKRNL.EXE!PsTerminateSystemThread, hint BB); NUSB USBPORT.SYS 5.00.2195.5652 (hint C2) (Appendix A row 113)
ntoskrnl.exe!ObReferenceObjectByHandle      all  required  w2k-export; win98-precedent ks.sys 4.10.2222 (NTOSKRNL.EXE!ObReferenceObjectByHandle, hint AA) (+11 other 98 SE) (Appendix A row 116). Called on NT only (IoIsWdmVersionAvailable(1, 0x10): Windows 2000 is WDM 1.10, Windows 98 1.00, ME 1.05): the stop waits on the thread object there and on an event on Windows 98, where that wait faulted (runs/run-26.md). A NULL object type: PsThreadType is a data import
ntoskrnl.exe!ObfDereferenceObject           all  required  w2k-export; win98-precedent hidclass.sys 4.10.2222 (NTOSKRNL.EXE!ObfDereferenceObject, hint AC) (+16 other 98 SE) (Appendix A row 34). The ObDereferenceObject macro; NT only, as above
# The stor98 link-state channel (cm_nvlinkos.c; tasks 39-A.7 and 40-A.7;
# stor98's stor98cm.h, its decision MD-6): the callback object
# \Callback\Stor98LinkState and its one callback, created at DriverEntry
# and unregistered at unload. Called on NT only (IoIsWdmVersionAvailable(1,
# 0x10)); Windows 98 SE and ME get no channel in this build (no callback
# object and no registry rendezvous), but the image still has to load
# there, and no stock 98 SE driver imports the
# three: their Windows 98 evidence is the name in ntkern.vxd alone, and
# the load of this image on 98 SE is the authoritative check.
ntoskrnl.exe!ExCreateCallback                all  required  SITES=cm_nvlinkos.obj w2k-export; ntkern-name (ntkern.vxd 4.10.2222's export-name strings; no 98 SE precedent). NT only at run time
ntoskrnl.exe!ExRegisterCallback              all  required  SITES=cm_nvlinkos.obj w2k-export; ntkern-name (no 98 SE precedent). NT only at run time
ntoskrnl.exe!ExUnregisterCallback            all  required  SITES=cm_nvlinkos.obj w2k-export; ntkern-name (no 98 SE precedent). NT only at run time

# --- the status record for the install tool's viewer (cm_statos.c, design
# record 24 section 3.2): pairs xhci98.sys imports, its evidence verbatim ---
ntoskrnl.exe!ZwSetValueKey                   all  required  SITES=cm_statos.obj w2k-export; win98-precedent usbhub.sys 4.10.2222 (NTOSKRNL.EXE!ZwSetValueKey, hint FF) (+12 other 98 SE); ntkern-name (design record 13 Appendix A row 159)
ntoskrnl.exe!RtlInitUnicodeString            all  required  SITES=cm_statos.obj w2k-export; win98-precedent usbhub.sys 4.10.2222 (NTOSKRNL.EXE!RtlInitUnicodeString, hint D7) (+47 other 98 SE); ntkern-name
ntoskrnl.exe!KeQuerySystemTime               all  required  SITES=cm_statos.obj,cm_qryos.obj w2k-export; win98-precedent uhcd.sys 4.10.2222 (NTOSKRNL.EXE!KeQuerySystemTime, hint 80) (+9 other 98 SE) (design record 13 section 7.4; Appendix A row 97). The record's stamp: the two words as returned, no arithmetic; and the query device's epoch (cm_qryos.c), compared word by word

# --- the query device (cm_qryos.c, design record 25 section 4.2): its
# \DosDevices\XHCICM<n> link. xhci98.sys's own pair for its HCD<n> names,
# its evidence verbatim, and IoRegisterDeviceInterface, whose link name
# carries the NHI's instance id (the interface is never enabled). That
# name and the IRP_MN_QUERY_ID answer are freed through cm_pool.c's CmFree
# (ExFreePool, SITES=cm_pool.obj above). ---
ntoskrnl.exe!IoRegisterDeviceInterface       all  required  w2k-export; win98-precedent usbhub.sys 4.10.2222 (NTOSKRNL.EXE!IoRegisterDeviceInterface, hint 54) (+9 other 98 SE); ntkern-name
ntoskrnl.exe!IoCreateSymbolicLink            all  required  w2k-export; win98-precedent usbd.sys 4.10.2222 (NTOSKRNL.EXE!IoCreateSymbolicLink, hint 3B) (+13 other 98 SE); ntkern-name (design record 13 Appendix A row 15)
ntoskrnl.exe!IoDeleteSymbolicLink            all  required  w2k-export; win98-precedent usbd.sys 4.10.2222 (NTOSKRNL.EXE!IoDeleteSymbolicLink, hint 3E) (+13 other 98 SE); ntkern-name (design record 13 Appendix A row 16)

[deny]

# xhci98-imports.allow's deny set, unchanged: each reason is a fact about a
# target and binds any binary loaded there.

ExAllocatePool              Not the HCD's spelling: task 25.3 found no Windows 98 SE or NUSB binary importing the untagged name, while ExAllocatePoolWithTag has dozens of stock 98 SE importers (design record 13 section 7). The HCD allocates with ExAllocatePoolWithTag and frees with ExFreePool.
ExFreePoolWithTag           No Windows 98 evidence at all (task 25.3: no stock 98 SE driver imports it, and NUSB 3.6's wdmstub.sys appears to supply it), so it stays denied after the pool rows arrive. Free with ExFreePool.
MmGetSystemRoutineAddress   Missing on Win98 (Oney p.438). There is no runtime symbol resolution on that target - every import decision is static and made here.
KeNumberProcessors          Not exported on Win98 (Oney p.441).
IoAllocateWorkItem          Not exported on Win98 (Oney p.375); task 25.3 found it among the names NUSB 3.6's wdmstub.sys supplies. ExQueueWorkItem has stock 98 SE precedent.
IoQueueWorkItem             Not exported on Win98 (Oney p.375).
IoFreeWorkItem              Not exported on Win98 (Oney p.375).
IoAcquireRemoveLock         The IO_REMOVE_LOCK family is missing on Win98 SE (Oney p.191). Keep an outstanding-I/O count instead.
IoReleaseRemoveLock         IO_REMOVE_LOCK family - missing on Win98 SE (Oney p.191).
IoReleaseRemoveLockAndWait  IO_REMOVE_LOCK family - missing on Win98 SE (Oney p.191).
MmMapLockedPagesSpecifyCache  Missing on Win98; MmGetSystemAddressForMdlSafe expands to it (Oney p.225).
MmGetPhysicalAddress        No Windows 98 binary precedent in any of the 86 scanned (task 25.3), and it would bypass the HAL's map registers.
HalGetAdapter               No Windows 98 binary precedent (task 25.3). The DMA adapter comes from IoGetDmaAdapter, as Windows 98 SE's own uhcd.sys and openhci.sys get theirs, and the two routes are never mixed (design record 13 section 11).
HalAllocateCommonBuffer     No Windows 98 binary precedent (task 25.3). Under ntddk.h a call by this name is a HAL import; call the adapter's DMA_OPERATIONS slot instead.
HalFreeCommonBuffer         Same as HalAllocateCommonBuffer.
PsGetVersion                Missing on Win98 (Oney p.437). Use IoIsWdmVersionAvailable.
KeReadStateEvent            Missing on Win98 (Oney p.95).
IoReportTargetDeviceChangeAsynchronous  Not exported on Win98 - a load-blocking import, not a runtime failure (Oney p.191).
PoRegisterDeviceNotify      Not implemented on Win98 (Oney p.254).
PoCancelDeviceNotify        Not implemented on Win98 (Oney p.254).
PoRegisterSystemState       Not implemented on Win98 (Oney p.254).
PoSetSystemState            Not implemented on Win98 (Oney p.254).
PoUnregisterSystemState     Not implemented on Win98 (Oney p.254).
HalTranslateBusAddress      Only partially available on Win98 (Oney p.441). Use the translated resources PnP supplies in IRP_MN_START_DEVICE.
KeAcquireInterruptSpinLock  Windows XP and later - blocks the load on Win2000 (docs\usb-xhci-info\win98-wdm.md).
KeReleaseInterruptSpinLock  Windows XP and later - blocks the load on Win2000.
IoForwardIrpSynchronously   Windows XP and later - blocks the load on Win2000. Use IoCallDriver plus a completion routine that signals a KEVENT.
IoSetCompletionRoutineEx    Windows XP and later - blocks the load on Win2000.
IoCsqInitialize             Cancel-safe queues arrived with the XP DDK and are not in the Win2K DDK's libraries.
IoCsqInsertIrp              Cancel-safe queue family - not in the Win2K DDK.
IoCsqRemoveNextIrp          Cancel-safe queue family - not in the Win2K DDK.
