/*
 * xhcitr.rc - the resources of XHCITR.EXE and XHCITR64.EXE (design record
 * 25 sections 3.1 and 9): the icon, the version from src\xhci_version.h,
 * the menu, the accelerators, the About dialog, and the manifest
 * (xhcitr.manifest, resource 1 of type 24, as xhciinst.rc carries its own).
 */

#include <windows.h>
#include "../src/xhci_version.h"
#include "tr_res.h"

IDI_APP ICON "xhcitr.ico"

1 24 "xhcitr.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     XHCI_VER_CSV
PRODUCTVERSION  XHCI_VER_CSV
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Yeo Kheng Meng\0"
            VALUE "FileDescription",  "xHCI98 USB Tree\0"
            VALUE "FileVersion",      XHCI_VER_STR "\0"
            VALUE "InternalName",     "xhcitr\0"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Yeo Kheng Meng. GNU GPL v2.\0"
            VALUE "OriginalFilename", "XHCITR.EXE\0"
            VALUE "ProductName",      "xhci98 - USB host controller driver for xHCI\0"
            VALUE "ProductVersion",   XHCI_VER_STR "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDR_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Refresh\tF5",            IDM_REFRESH
        MENUITEM "&Save Report...\tCtrl+S", IDM_SAVE
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                   IDM_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy\tCtrl+C",           IDM_COPY
        MENUITEM "Select &All\tCtrl+A",     IDM_SELALL
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Thunderbolt and USB4",               IDM_V_TB
        MENUITEM "&USB controllers",                    IDM_V_USB
        MENUITEM "&Windows' own USB controllers",       IDM_V_WINUSB
        MENUITEM "&Empty ports",                        IDM_V_EMPTY
        MENUITEM "&Descriptors",                        IDM_V_DESC
        MENUITEM "Devices &behind each tunnel",         IDM_V_BEHIND
        MENUITEM SEPARATOR
        MENUITEM "Auto &Refresh",                       IDM_V_AUTO
        MENUITEM SEPARATOR
        MENUITEM "Start at &login",                     IDM_LOGIN
    END
    POPUP "&Action"
    BEGIN
        MENUITEM "&Safely Remove...\tDel",  IDM_EJECT
        MENUITEM "&Properties\tEnter",      IDM_PROPS
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About xHCI98 USB Tree",  IDM_ABOUT
    END
END

IDR_ACCEL ACCELERATORS
BEGIN
    VK_F5,      IDM_REFRESH,    VIRTKEY
    "S",        IDM_SAVE,       VIRTKEY, CONTROL
    "C",        IDM_COPY,       VIRTKEY, CONTROL
    "A",        IDM_SELALL,     VIRTKEY, CONTROL
    VK_DELETE,  IDM_EJECT,      VIRTKEY
    VK_RETURN,  IDM_PROPS,      VIRTKEY
END

IDD_ABOUT DIALOG 0, 0, 240, 112
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About xHCI98 USB Tree"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDI_APP, IDC_ABOUT_ICON, 8, 8, 21, 20
    LTEXT           "", IDC_ABOUT_TEXT, 40, 8, 192, 76
    DEFPUSHBUTTON   "OK", IDOK, 182, 90, 50, 14
END

IDD_ELEVATE DIALOG 0, 0, 260, 84
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Stop a Thunderbolt device"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "", IDC_ELEV_TEXT, 8, 8, 244, 48
    DEFPUSHBUTTON   "Stop as administrator...", IDOK, 96, 62, 100, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 202, 62, 50, 14
END
