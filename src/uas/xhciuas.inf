; xhciuas.inf - the project's USB Attached SCSI class driver, xhciuas.sys
; (roadmap-hcd.md task 31-A.2), the second INF of the 32-bit package.
;
; It binds the driver to a USB device or function whose interface is Mass
; Storage / SCSI / UAS - the compatible id USB\Class_08&SubClass_06&Prot_62
; the bus (xhci98.sys) exposes when it chooses UAS for the device (task
; 31-A.3). The driver is the FDO on that PDO and creates one PDO per logical
; unit, which the OS's own storage INFs bind: disk.inf on Windows 2000 and
; later, NUSB's usbntmap.inf on Windows 98 SE. Nothing here touches those.
;
; Two install paths, as xhci98.inf: Windows 98 SE and ME read the undecorated
; sections and load the driver through *NTKERN/NTMPDriver; every NT target
; reads the .NTx86 sections and installs a kernel service. The driver needs
; no OS-supplied file, so there is no LayoutFile and no NT 6.x models
; section: the .NTx86 path copies the driver alone on every NT target.
;
; scripts\inf-gate\check-uas-inf.ps1 gates this file on every build.
;
; ASCII only, CRLF line endings.

[Version]
Signature="$CHICAGO$"
Class=USB
ClassGUID={36FC9E60-C465-11CF-8056-444553540000}
Provider=%Provider%
; Must equal src\xhci_version.h.
DriverVer=10/02/2026,1.99.0.0

[Manufacturer]
%Mfg%=UasModels

[UasModels]
%UasDesc%=Uas.Dev,USB\Class_08&SubClass_06&Prot_62

[SourceDisksNames]
1=%DiskName%,xhciuas.sys,,

[SourceDisksFiles]
xhciuas.sys=1
xhciuas.inf=1

[DestinationDirs]
DefaultDestDir=10
Uas.CopyFiles=10,System32\Drivers
Inf.CopyFiles=17

; --- Windows 98 SE and ME ---------------------------------------------------

[Uas.Dev]
AddReg=Uas.AddReg
CopyFiles=Uas.CopyFiles

[Uas.AddReg]
HKR,,DevLoader,,*NTKERN
HKR,,NTMPDriver,,xhciuas.sys

; --- Windows 2000 and every later NT target ---------------------------------

[Uas.Dev.NTx86]
CopyFiles=Uas.CopyFiles

[Uas.Dev.NTx86.Services]
AddService=xhciuas,0x00000002,Uas.AddService

[Uas.AddService]
DisplayName=%UasSvcDesc%
ServiceType=1                       ; SERVICE_KERNEL_DRIVER
StartType=3                         ; SERVICE_DEMAND_START
ErrorControl=1                      ; SERVICE_ERROR_NORMAL
ServiceBinary=%12%\xhciuas.sys
LoadOrderGroup=Base

; --- Files ------------------------------------------------------------------

[Uas.CopyFiles]
xhciuas.sys,,xhciuas.tmp

[Inf.CopyFiles]
xhciuas.inf

; Right-click Install pre-stages the driver with no device present.
[DefaultInstall]
CopyFiles=Inf.CopyFiles,Uas.CopyFiles

[DefaultInstall.NTx86]
CopyFiles=Uas.CopyFiles

[Strings]
Provider="Yeo Kheng Meng"
Mfg="xHCI98 Project"
DiskName="xhci98 xHCI Host Controller Disk"
UasDesc="xHCI98 USB Attached SCSI Storage"
UasSvcDesc="xHCI98 USB Attached SCSI Class Driver (xhciuas)"
