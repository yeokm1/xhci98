/*
 * xhcihlpr.rc - the file version resource of xhcihlpr.sys, the x86 helper
 * (design record 18, section 15 for this revision). The version is the package's, from
 * src\xhci_version.h, so the helper and the HCD of one package cannot
 * disagree and xhci98.inf's DriverVer is checked against the same header.
 */

#include <windows.h>
#include "../xhci_version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     XHCI_VER_CSV
PRODUCTVERSION  XHCI_VER_CSV
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#if DBG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DRV
FILESUBTYPE     VFT2_DRV_SYSTEM
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Yeo Kheng Meng\0"
            VALUE "FileDescription",  "xhci98 helper for 32-bit Windows 2000, XP, Vista and 7\0"
            VALUE "FileVersion",      XHCI_VER_STR "\0"
            VALUE "InternalName",     "xhcihlpr.sys\0"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Yeo Kheng Meng. GNU GPL v2 or later.\0"
            VALUE "OriginalFilename", "xhcihlpr.sys\0"
            VALUE "ProductName",      "xhci98 - USB host controller driver for xHCI\0"
            VALUE "ProductVersion",   XHCI_VER_STR "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
