; xhci98-amd64.inf - the successor xHCI host controller driver, the 64-bit
; package
;
; The amd64 counterpart of src\xhci98.inf, for the reasons the miniport's
; two INFs were two files: a second binary from a second
; toolchain (WDK 7.1) in a second package, with no Windows 98 path - an
; undecorated section here is one a 32-bit engine falls back to (PATH-NO9X).
; NT 5.2 takes [XhciModels.NTamd64], which fetches usbd.sys and usbui.dll
; through LayoutFile; Vista and Windows 7 x64 take [XhciModels.NTamd64.6.0],
; which copies the driver alone. Both models sections carry the controller
; and the root hub the controller creates, under the project-owned id
; (xhci98.inf has the long form), with the hubs and composite devices the
; bus presents. The four ids are under USB\ since 2.4.0.0 (task 38.8; design
; record 13 section 10.13), XHCI98\ before; no old id is named here, and the
; root hub's sections copy nothing (decision D3, as the hubs').
;
; Written as task 25.8's scaffold INF; stageable since 26-A.1 removed the
; scaffold marker from the image. Task 28-A.2 (taken at the start of Phase
; 27) is the amd64 build that loads in a guest: this file's first install
; is its XP x64 leg, and 28-V.1 the rest of the amd64 guests.
;
; ASCII only, CRLF line endings.

[Version]
Signature="$CHICAGO$"
Class=USB
ClassGUID={36FC9E60-C465-11CF-8056-444553540000}
Provider=%Provider%
LayoutFile=layout.inf
; Must equal src\xhci_version.h.
DriverVer=10/13/2026,2.3.1.0

[Manufacturer]
%Mfg%=XhciModels,NTamd64,NTamd64.6.0

[XhciModels.NTamd64]
%XhciDesc%=Xhci.Dev,PCI\CC_0C0330
%RootHubDesc%=RootHub.Dev,USB\XHCI98_ROOT_HUB
%HubDesc%=Hub.Dev,USB\XHCI98_HUB
%Hub30Desc%=Hub.Dev,USB\XHCI98_HUB30
%CompositeDesc%=Comp.Dev,USB\XHCI98_COMPOSITE

[XhciModels.NTamd64.6.0]
%XhciDesc%=Xhci.Dev6,PCI\CC_0C0330
%RootHubDesc%=RootHub.Dev6,USB\XHCI98_ROOT_HUB
%HubDesc%=Hub.Dev6,USB\XHCI98_HUB
%Hub30Desc%=Hub.Dev6,USB\XHCI98_HUB30
%CompositeDesc%=Comp.Dev6,USB\XHCI98_COMPOSITE

[SourceDisksNames]
1=%DiskName%,xhci98.sys,,

[SourceDisksFiles]
xhci98.sys=1
xhci98.inf=1

[DestinationDirs]
DefaultDestDir=10
Xhci.CopyFiles=10,System32\Drivers
Xhci.CopyOS=10,System32\Drivers
Xhci.CopyUI=11

[Xhci.Dev.NTamd64]
AddReg=Xhci.AddReg.NT
CopyFiles=Xhci.CopyFiles,Xhci.CopyOS,Xhci.CopyUI

[Xhci.Dev.NTamd64.Services]
AddService=xhci98,0x00000002,Xhci.AddService

[Xhci.Dev6.NTamd64]
AddReg=Xhci.AddReg.NT
CopyFiles=Xhci.CopyFiles

[Xhci.Dev6.NTamd64.HW]
AddReg=Xhci.Msi.AddReg

[Xhci.Dev6.NTamd64.Services]
AddService=xhci98,0x00000002,Xhci.AddService

[RootHub.Dev.NTamd64]
AddReg=RootHub.AddReg.NT

[RootHub.Dev.NTamd64.Services]
AddService=xhci98,0x00000002,Xhci.AddService

[RootHub.Dev6.NTamd64]
AddReg=RootHub.AddReg.NT

[RootHub.Dev6.NTamd64.Services]
AddService=xhci98,0x00000002,Xhci.AddService

; An external hub (task 33.4; design record 13, section 10.11): presented by
; the bus under USB\XHCI98_HUB or USB\XHCI98_HUB30 and bound to xhci98.sys
; again.
; Its sections copy NOTHING - the devnode exists only under a running
; xhci98.sys - so a hub plugged in long after the install never asks for the
; original media (HCD-HUBCOPY).
[Hub.Dev.NTamd64]
AddReg=RootHub.AddReg.NT

[Hub.Dev.NTamd64.Services]
AddService=xhci98,0x00000002,Xhci.AddService

[Hub.Dev6.NTamd64]
AddReg=RootHub.AddReg.NT

[Hub.Dev6.NTamd64.Services]
AddService=xhci98,0x00000002,Xhci.AddService

; Message-signalled interrupts on Vista and 7 (design record 15 section
; 4.3, task 36.15): one message asked for in the controller's hardware key.
; NOCLOBBER keeps a user's MSISupported 0 - the way to force the line besides
; XhciInterruptMode 1 - across an update; the driver, not this limit, holds
; the delivery to Interrupter 0's one message.
[Xhci.Msi.AddReg]
HKR,"Interrupt Management",,0x00000010
HKR,"Interrupt Management\MessageSignaledInterruptProperties",,0x00000010
HKR,"Interrupt Management\MessageSignaledInterruptProperties",MSISupported,0x00010003,1
HKR,"Interrupt Management\MessageSignaledInterruptProperties",MessageNumberLimit,0x00010003,1

; A composite device (task 36.43; design record 13, section 10.12): its
; function PDOs beneath a devnode of its own under USB\XHCI98_COMPOSITE,
; bound to xhci98.sys again. Copies NOTHING (HCD-HUBCOPY) and registers no property
; page (HCD-COMPPAGE); the hub page an earlier driver may have left goes, as
; XP's own usb.inf installs its composite parent.
[Comp.Dev.NTamd64]
DelReg=Comp.DelReg.NT

[Comp.Dev.NTamd64.Services]
AddService=xhci98,0x00000002,Xhci.AddService

[Comp.Dev6.NTamd64]
DelReg=Comp.DelReg.NT

[Comp.Dev6.NTamd64.Services]
AddService=xhci98,0x00000002,Xhci.AddService

[Comp.DelReg.NT]
HKR,,EnumPropPages32

[Xhci.AddService]
DisplayName=%XhciSvcDesc%
ServiceType=1                       ; SERVICE_KERNEL_DRIVER
StartType=3                         ; SERVICE_DEMAND_START
ErrorControl=1                      ; SERVICE_ERROR_NORMAL
ServiceBinary=%12%\xhci98.sys
LoadOrderGroup=Base

[Xhci.AddReg.NT]
HKR,,XhciLogVerbosity,0x00010003,0
HKR,,XhciLogDebugView,0x00010003,0
HKR,,XhciForceBulkOnly,0x00010003,0
HKR,,XhciFastPollFsLs,0x00010003,0
HKR,,XhciFirstEnumWaitMs,0x00010003,5000
HKR,,XhciFirstEnumPortMs,0x00010003,2000
HKR,,XhciIntelPortSwitch,0x00010003,0
HKR,,XhciIntelIrqRoute,0x00010003,1
HKR,,XhciTolerance,0x00010003,1
HKR,,XhciIntervalCap,0x00010003,1
HKR,,XhciAvgTrbEsit,0x00010003,0
HKR,,XhciMaxTransferKB,0x00010003,1024
HKR,,XhciInterruptMode,0x00010003,0
HKR,,XhciPollIdleMs,0x00010003,50
HKR,,XhciPollActiveMs,0x00010003,1
HKR,,XhciPollFineTimer,0x00010003,1
HKR,,XhciWideMap,0x00010003,0
HKR,,XhciSelectiveSuspend,0x00010003,0
HKR,,XhciUsb2HubSpeedFallback,0x00010003,1
HKR,,XhciAccept096,0x00010003,1
HKR,,XhciImodInterval250ns,0x00010003,160
HKR,,EnumPropPages32,,"usbui.dll,USBControllerPropPageProvider"
HKR,,Controller,1,01

; The root hub's Power tab (design record 13, section 8).
[RootHub.AddReg.NT]
HKR,,EnumPropPages32,,"usbui.dll,USBHubPropPageProvider"

[Xhci.CopyFiles]
xhci98.sys

[Xhci.CopyOS]
usbd.sys,,,16

[Xhci.CopyUI]
usbui.dll,,,16

[DefaultInstall.NTamd64]
CopyFiles=Xhci.CopyFiles,Xhci.CopyOS,Xhci.CopyUI

[Strings]
Provider="Yeo Kheng Meng"
Mfg="xHCI98 Project"
DiskName="xhci98 xHCI Host Controller Disk"
XhciDesc="xHCI98 USB 3.x eXtensible Host Controller"
RootHubDesc="xHCI98 USB 3.x Root Hub"
HubDesc="xHCI98 USB Hub"
Hub30Desc="xHCI98 USB 3.x Hub"
CompositeDesc="xHCI98 USB Composite Device"
XhciSvcDesc="xHCI98 USB 3.x eXtensible Host Controller Driver (xhci98)"
