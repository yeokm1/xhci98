;
; stor98-x86.inf - the 32-bit stor98 package, shipped as x86\stor98.inf next
; to stor98.mpd and stor98.sys. One INF serves every 32-bit target, for any
; PCI NVMe controller (class 01, subclass 08, interface 02):
;
;   Windows 98 SE, ME    the undecorated install section: stor98.mpd into
;                        SYSTEM\IOSUBSYS (DIRID 12), loaded by IOS as the
;                        SCSI port driver of the device (DevLoader *IOS,
;                        PortDriver). Derived from SweetLow's nvme9x.inf,
;                        without its NVMEVSD.VXD helper (docs/PLAN.md 0.12).
;   Windows 2000, XP,    the .NTx86 install and services sections:
;   Vista, 7 (32-bit)    stor98.sys into system32\drivers (DIRID 12 on NT)
;                        as the demand-start SCSIport miniport service
;                        stor98. Derived from upstream nvme2k 1.2.0.0
;                        WDM\NVMe2K.inf.
;
; Each OS copies only its own image: the 9x section lists stor98.mpd alone
; and the NT section stor98.sys alone. The models section is undecorated, so
; 64-bit Windows does not offer this INF; it installs from x64\stor98.inf.
;
; Data disks only on NT. The service is demand-start (StartType=3): Plug and
; Play loads stor98.sys when it enumerates an NVMe controller, so a driver
; that is refused leaves only that device stopped and Windows still starts.
; Booting from an NVMe disk needs StartType=0, which no release supports yet
; (docs/BUILD.md, "INFs and version").
;
; DriverVer must equal src\stor98ver.h and x64\stor98.inf; make-release.ps1
; checks it. ASCII only, CRLF line endings.

[Version]
Signature="$CHICAGO$"
Class=SCSIAdapter
ClassGUID={4D36E97B-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=10/16/2026,0.4.0.0

[DestinationDirs]
; DIRID 12: Windows\System\IoSubsys on Windows 9x, system32\drivers on NT.
DefaultDestDir=12

[SourceDisksNames]
1=%DiskName%,,

[SourceDisksFiles]
stor98.mpd=1
stor98.sys=1

[Manufacturer]
%Mfg%=Stor98_Models

[Stor98_Models]
%Stor98.DeviceDesc%=Stor98_Inst,PCI\CC_010802

; ---- Windows 98 SE and ME --------------------------------------------------

[Stor98_Inst]
CopyFiles=Stor98_Files_9x
AddReg=Stor98_IOS,Stor98_AddReg_9x

[Stor98_Files_9x]
stor98.mpd

[Stor98_IOS]
HKR,,DevLoader,,*IOS
HKR,,DontLoadIfConflict,,"Y"

[Stor98_AddReg_9x]
HKR,,PortDriver,,stor98.mpd

; ---- Windows 2000, XP, Vista and 7, 32-bit ---------------------------------

[Stor98_Inst.NTx86]
CopyFiles=Stor98_Files_NT

[Stor98_Inst.NTx86.Services]
AddService=stor98,%SPSVCINST_ASSOCSERVICE%,Stor98_Service,Stor98_EventLog

[Stor98_Files_NT]
stor98.sys

[Stor98_Service]
DisplayName=%Stor98.ServiceDesc%
ServiceType=%SERVICE_KERNEL_DRIVER%
; Demand-start: data disks only (see the header).
StartType=%SERVICE_DEMAND_START%
ErrorControl=%SERVICE_ERROR_NORMAL%
ServiceBinary=%12%\stor98.sys
LoadOrderGroup=SCSI Miniport
AddReg=Stor98_ServiceReg

[Stor98_ServiceReg]
HKR,"Parameters\PnpInterface","5",%REG_DWORD%,0x00000001
HKR,"Parameters\Device","MaximumSGList",%REG_DWORD%,0x000000FF
HKR,"Parameters\Device","NumberOfRequests",%REG_DWORD%,0x00000020

[Stor98_EventLog]
AddReg=Stor98_EventLogReg

[Stor98_EventLogReg]
HKR,,EventMessageFile,%REG_EXPAND_SZ%,"%%SystemRoot%%\System32\IoLogMsg.dll"
HKR,,TypesSupported,%REG_DWORD%,7

[Strings]
Provider="Yeo Kheng Meng"
Mfg="Stor98 Project"
Stor98.DeviceDesc="Stor98 Storage Controller for NVMe SSDs"
Stor98.ServiceDesc="Stor98 Storage Controller Driver (stor98)"
DiskName="Stor98 Storage Controller Disk"

; Not localizable
SPSVCINST_ASSOCSERVICE=0x00000002
SERVICE_KERNEL_DRIVER=1
SERVICE_DEMAND_START=3
SERVICE_ERROR_NORMAL=1
REG_EXPAND_SZ=0x00020000
REG_DWORD=0x00010001
