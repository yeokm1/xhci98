; SPDX-License-Identifier: BSD-3-Clause
; Copyright (c) 2025 Dominik Behr + Ray Hinchliffe (NVMe2K.inf), (c) 2026 Yeo Kheng Meng
;
; stor98-x64.inf - the 64-bit stor98 package, shipped as x64\stor98.inf next
; to the amd64 stor98.sys. Installs the SCSIport miniport on Windows XP x64,
; Server 2003 x64, Vista x64 and 7 x64, for any PCI NVMe controller (class
; 01, subclass 08, interface 02). Windows 8 x64, 8.1 x64 and 10 x64 refuse
; it as it stands: with no CatalogFile, their driver store will not import
; it in test-signing mode (0xE000022F, read 2026-10-22, xhci98 roadmap
; 43.23). Derived from upstream nvme2k 1.2.0.0
; WDM\NVMe2K.inf.
;
; Only the NTamd64 models section lists a device, so 32-bit Windows does not
; offer this INF; the 32-bit targets install from x86\stor98.inf. There is
; no undecorated models section, empty or not: xhci98's installer refuses a
; 64-bit INF that has one (inst_inf_arch_ok), as Stor98 0.4.0.0's had none.
;
; Data disks only. The service is demand-start (StartType=3): Plug and Play
; loads stor98.sys when it enumerates an NVMe controller, so a driver that
; is refused leaves only that device stopped (Code 52 on Vista x64 and 7 x64
; without a signature they accept) and Windows still starts. Upstream used
; boot-start (StartType=0); Windows 7 x64 treats a boot-start image that
; fails code integrity as a failed start even when the system disk is on
; another controller (Startup Repair runs and System Restore removes the
; driver). Booting from an NVMe disk needs StartType=0 and, on Vista x64 and
; 7 x64, a signature they trust or test-signing left on permanently; this
; release does not support booting from NVMe.
;
; DriverVer is xhci98's package version and release date, from
; src\xhci_version.h (XHCI_VER_STR, XHCI_DRIVERVER_DATE), as in the other
; INF; xhci98's scripts\inf-gate\check-stor98-inf.ps1 checks it.
; ASCII only, CRLF line endings.

[Version]
Signature="$Windows NT$"
Class=SCSIAdapter
ClassGUID={4D36E97B-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=10/19/2026,3.1.0.0
; Made and test-signed by the packager alone (design record 19).
CatalogFile=stor98.cat

[DestinationDirs]
DefaultDestDir=12   ; DIRID_DRIVERS

[SourceDisksNames]
1=%DiskName%,,

[SourceDisksFiles]
stor98.sys=1

[Manufacturer]
; Windows 8.1 and 10 (NT 6.3 and later) have their own NVMe driver, stornvme,
; and keep it (owner, 2026-10-23, roadmap-usb4 43.59): there the models give
; PCI\CC_010802 as this INF's compatible id, its hardware id empty, so the
; match ranks as compatible-to-compatible, below stornvme's hardware-id
; match on the same id, signed or not, and Stor98 binds only where the
; installer puts it on one drive (case 3b, UpdateDriverForPlugAndPlayDevices
; with this INF) or a user does. Windows 8, which has no stornvme, and every
; earlier system keep PCI\CC_010802 as the hardware id.
%Mfg%=Stor98_Models,NTamd64,NTamd64.6.3

[Stor98_Models.NTamd64]
%Stor98.DeviceDesc%=Stor98_Inst,PCI\CC_010802

[Stor98_Models.NTamd64.6.3]
%Stor98.DeviceDesc%=Stor98_Inst,,PCI\CC_010802

[Stor98_Inst.NTamd64]
CopyFiles=Stor98_CopyFiles

[Stor98_CopyFiles]
stor98.sys

[Stor98_Inst.NTamd64.Services]
AddService=stor98,%SPSVCINST_ASSOCSERVICE%,Stor98_Service,Stor98_EventLog

[Stor98_Service]
DisplayName=%Stor98.ServiceDesc%
ServiceType=%SERVICE_KERNEL_DRIVER%
; Demand-start: data disks only (see the header).
StartType=%SERVICE_DEMAND_START%
ErrorControl=%SERVICE_ERROR_NORMAL%
ServiceBinary=%12%\stor98.sys
LoadOrderGroup=SCSI Miniport
AddReg=Stor98_ServiceReg
DelReg=Stor98_ServiceDelReg

[Stor98_ServiceReg]
HKR,"Parameters\PnpInterface","5",%REG_DWORD%,0x00000001
HKR,"Parameters\Device","MaximumSGList",%REG_DWORD%,0x000000FF
HKR,"Parameters\Device","NumberOfRequests",%REG_DWORD%,0x00000020
; No DmaRemappingCompatible: with the value 1 Windows 10 x64 (19045) does
; not start this SCSIport miniport at all (Code 10, 0xC00000C2, event 4),
; on a machine with no Kernel DMA Protection either (docs/PLAN.md, the
; reading of 2026-10-23). An update over a build that wrote it deletes it.

[Stor98_ServiceDelReg]
HKR,"Parameters","DmaRemappingCompatible"

[Stor98_EventLog]
AddReg=Stor98_EventLogReg

[Stor98_EventLogReg]
HKR,,EventMessageFile,%REG_EXPAND_SZ%,"%%SystemRoot%%\System32\IoLogMsg.dll"
HKR,,TypesSupported,%REG_DWORD%,7

[Strings]
Provider="Yeo Kheng Meng"
Mfg="Stor98 Project"
Stor98.DeviceDesc="Stor98 Storage Controller for NVMe SSDs"
Stor98.ServiceDesc="Stor98 Storage Controller Driver (stor98)"
DiskName="Stor98 Storage Controller Disk"

; Not localizable
SPSVCINST_ASSOCSERVICE=0x00000002
SERVICE_KERNEL_DRIVER=1
SERVICE_DEMAND_START=3
SERVICE_ERROR_NORMAL=1
REG_EXPAND_SZ=0x00020000
REG_DWORD=0x00010001
