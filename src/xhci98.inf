; xhci98.inf - the successor xHCI host controller driver, the 32-bit package
;
; xhci98.sys is a monolithic bus driver (design record 13): it replaces
; usbport.sys, the hub driver and the composite parent, so this file installs
; it in TWO roles from one binary - as the function driver of the PCI xHCI
; controller, and as the function driver of the root hub the controller
; creates under a project-owned hardware id, never USB\ROOT_HUB, which the
; OS's own usbhub.sys claims on every NT target (roadmap-hcd.md, decisions
; table). Device PDOs are children of that root hub, or of the external hub
; they sit behind, which the bus presents as a third role of the same binary
; under XHCI98\HUB or XHCI98\HUB30 (task 33.4); a composite device's function
; PDOs are children of its composite parent, a fourth role under
; XHCI98\COMPOSITE (task 36.43).
;
; Written as task 25.8's scaffold INF and stageable since 26-A.1 removed the
; scaffold marker from the image; the root hub's id is the one task 25.4
; chose (design record 13, section 8). Its first install was task 26-V.0's.
;
; The install-path rules are the ones the miniport's INF carried until
; 1.2.0.0, and scripts\inf-gate\check-inf.ps1 enforces them: Windows 98 SE and ME read the undecorated
; sections and load the driver through *NTKERN/NTMPDriver; Windows 2000 and
; 32-bit XP the .NTx86 sections, as a kernel service; 32-bit Vista and
; Windows 7 the NT 6.x models section, which copies the driver alone.
;
; ASCII only, CRLF line endings.
;
; The OS supplies usbd.sys - the class drivers above the HCD's device PDOs
; import its helper exports - and usbui.dll, the property-page provider,
; through LayoutFile exactly as for the miniport. usbport.sys and usbhub.sys
; are NOT fetched: the HCD replaces both.

[Version]
Signature="$CHICAGO$"
Class=USB
ClassGUID={36FC9E60-C465-11CF-8056-444553540000}
Provider=%Provider%
LayoutFile=layout.inf
; Must equal src\xhci_version.h.
DriverVer=10/13/2026,2.3.1.0

[Manufacturer]
%Mfg%=XhciModels,NTx86.6.0

[XhciModels]
%XhciDesc%=Xhci.Dev,PCI\CC_0C0330
%RootHubDesc%=RootHub.Dev,XHCI98\ROOT_HUB
%HubDesc%=Hub.Dev,XHCI98\HUB
%Hub30Desc%=Hub.Dev,XHCI98\HUB30
%CompositeDesc%=Comp.Dev,XHCI98\COMPOSITE

[XhciModels.NTx86.6.0]
%XhciDesc%=Xhci.Dev6,PCI\CC_0C0330
%RootHubDesc%=RootHub.Dev6,XHCI98\ROOT_HUB
%HubDesc%=Hub.Dev6,XHCI98\HUB
%Hub30Desc%=Hub.Dev6,XHCI98\HUB30
%CompositeDesc%=Comp.Dev6,XHCI98\COMPOSITE

[SourceDisksNames]
1=%DiskName%,xhci98.sys,,

[SourceDisksFiles]
xhci98.sys=1
xhcimsi.sys=1
xhci98.inf=1

[DestinationDirs]
DefaultDestDir=10
Xhci.CopyFiles=10,System32\Drivers
XhciMsi.CopyFiles=10,System32\Drivers
Xhci.CopyOS=10,System32\Drivers
Xhci.CopyUI=11
Inf.CopyFiles=17

; --- Windows 98 SE and ME ---------------------------------------------------

[Xhci.Dev]
AddReg=Xhci.AddReg
CopyFiles=Xhci.CopyFiles,Xhci.CopyOS,Xhci.CopyUI

[Xhci.AddReg]
HKR,,DevLoader,,*NTKERN
HKR,,NTMPDriver,,xhci98.sys
HKR,,EnumPropPages,,"sysclass.dll,USBControllerPropPage"
HKR,,XhciLogVerbosity,0x00010003,0
HKR,,XhciLogDebugView,0x00010003,0
HKR,,XhciForceBulkOnly,0x00010003,0
HKR,,XhciFastPollFsLs,0x00010003,0
HKR,,XhciFirstEnumWaitMs,0x00010003,5000
HKR,,XhciFirstEnumPortMs,0x00010003,2000
HKR,,XhciIntelPortSwitch,0x00010003,0
HKR,,XhciIntelIrqRoute,0x00010003,1
HKR,,XhciTolerance,0x00010003,1
HKR,,XhciIntervalCap,0x00010003,1
HKR,,XhciAvgTrbEsit,0x00010003,0
HKR,,XhciMaxTransferKB,0x00010003,1024
HKR,,XhciInterruptMode,0x00010003,0
HKR,,XhciPollIdleMs,0x00010003,50
HKR,,XhciPollActiveMs,0x00010003,1
HKR,,XhciWideMap,0x00010003,0
HKR,,XhciSelectiveSuspend,0x00010003,0
HKR,,XhciUsb2HubSpeedFallback,0x00010003,1
HKR,,XhciAccept096,0x00010003,1
HKR,,XhciImodInterval250ns,0x00010003,160

[RootHub.Dev]
AddReg=RootHub.AddReg
CopyFiles=Xhci.CopyFiles

[RootHub.AddReg]
HKR,,DevLoader,,*NTKERN
HKR,,NTMPDriver,,xhci98.sys
; The root hub's Power tab, as Windows 98 SE's, ME's and NUSB's own INFs register it
; for their root hubs (design record 13, section 8).
HKR,,EnumPropPages,,"sysclass.dll,USBHubPropPage"

; An external hub (task 33.4; design record 13, section 10.11): the bus
; serves it and presents it as a devnode under XHCI98\HUB or XHCI98\HUB30,
; bound to xhci98.sys again. Its sections copy NOTHING: the devnode exists
; only under a running xhci98.sys, so the binary is on disk and loaded, and
; a hub plugged in long after the install must not send the setup engine
; looking for the original media. The gate holds that (HCD-HUBCOPY).
[Hub.Dev]
AddReg=Hub.AddReg

[Hub.AddReg]
HKR,,DevLoader,,*NTKERN
HKR,,NTMPDriver,,xhci98.sys
HKR,,EnumPropPages,,"sysclass.dll,USBHubPropPage"

; A composite device (task 36.43; design record 13, section 10.12): the bus
; splits it and presents its functions beneath a devnode of its own under
; XHCI98\COMPOSITE, bound to xhci98.sys again. Like a hub's, its sections
; copy NOTHING (HCD-HUBCOPY) and, a composite not being a hub, register no
; property page (HCD-COMPPAGE).
[Comp.Dev]
AddReg=Comp.AddReg

[Comp.AddReg]
HKR,,DevLoader,,*NTKERN
HKR,,NTMPDriver,,xhci98.sys

; --- Windows 2000 and 32-bit XP ---------------------------------------------

[Xhci.Dev.NTx86]
AddReg=Xhci.AddReg.NT
CopyFiles=Xhci.CopyFiles,Xhci.CopyOS,Xhci.CopyUI

[Xhci.Dev.NTx86.Services]
AddService=xhci98,0x00000002,Xhci.AddService

[Xhci.AddReg.NT]
HKR,,XhciLogVerbosity,0x00010003,0
HKR,,XhciLogDebugView,0x00010003,0
HKR,,XhciForceBulkOnly,0x00010003,0
HKR,,XhciFastPollFsLs,0x00010003,0
HKR,,XhciFirstEnumWaitMs,0x00010003,5000
HKR,,XhciFirstEnumPortMs,0x00010003,2000
HKR,,XhciIntelPortSwitch,0x00010003,0
HKR,,XhciIntelIrqRoute,0x00010003,1
HKR,,XhciTolerance,0x00010003,1
HKR,,XhciIntervalCap,0x00010003,1
HKR,,XhciAvgTrbEsit,0x00010003,0
HKR,,XhciMaxTransferKB,0x00010003,1024
HKR,,XhciInterruptMode,0x00010003,0
HKR,,XhciPollIdleMs,0x00010003,50
HKR,,XhciPollActiveMs,0x00010003,1
HKR,,XhciWideMap,0x00010003,0
HKR,,XhciSelectiveSuspend,0x00010003,0
HKR,,XhciUsb2HubSpeedFallback,0x00010003,1
HKR,,XhciAccept096,0x00010003,1
HKR,,XhciImodInterval250ns,0x00010003,160
HKR,,EnumPropPages32,,"usbui.dll,USBControllerPropPageProvider"
HKR,,Controller,1,01

[RootHub.Dev.NTx86]
AddReg=RootHub.AddReg.NT
CopyFiles=Xhci.CopyFiles

[RootHub.Dev.NTx86.Services]
AddService=xhci98,0x00000002,Xhci.AddService

; The root hub's Power tab on every NT target: the provider each NT usb.inf
; registers for its own root hubs (design record 13, section 8).
[RootHub.AddReg.NT]
HKR,,EnumPropPages32,,"usbui.dll,USBHubPropPageProvider"

[Hub.Dev.NTx86]
AddReg=RootHub.AddReg.NT

[Hub.Dev.NTx86.Services]
AddService=xhci98,0x00000002,Xhci.AddService

; As XP's own usb.inf installs its composite parent: the hub page an
; earlier driver may have left on the devnode's key goes.
[Comp.Dev.NTx86]
DelReg=Comp.DelReg.NT

[Comp.Dev.NTx86.Services]
AddService=xhci98,0x00000002,Xhci.AddService

[Comp.DelReg.NT]
HKR,,EnumPropPages32

; --- 32-bit Vista and Windows 7 ---------------------------------------------

; The controller on 32-bit Vista and 7 also gets xhcimsi.sys, the NT 6 x86
; MSI helper (design record 18): a boot-start service that hands
; IoConnectInterruptEx to xhci98.sys, which also loads on Windows 98 and so
; cannot import it. A boot-start service starts at the next boot, so this
; section asks for a restart (Reboot; owner, 2026-10-09). No other section
; of this file names the helper, its service or a restart.
[Xhci.Dev6.NTx86]
AddReg=Xhci.AddReg.NT
CopyFiles=Xhci.CopyFiles,XhciMsi.CopyFiles
Reboot

[Xhci.Dev6.NTx86.HW]
AddReg=Xhci.Msi.AddReg

[Xhci.Dev6.NTx86.Services]
AddService=xhci98,0x00000002,Xhci.AddService
AddService=xhcimsi,,XhciMsi.AddService

[RootHub.Dev6.NTx86]
AddReg=RootHub.AddReg.NT
CopyFiles=Xhci.CopyFiles

[RootHub.Dev6.NTx86.Services]
AddService=xhci98,0x00000002,Xhci.AddService

[Hub.Dev6.NTx86]
AddReg=RootHub.AddReg.NT

[Hub.Dev6.NTx86.Services]
AddService=xhci98,0x00000002,Xhci.AddService

[Comp.Dev6.NTx86]
DelReg=Comp.DelReg.NT

[Comp.Dev6.NTx86.Services]
AddService=xhci98,0x00000002,Xhci.AddService

[Xhci.AddService]
DisplayName=%XhciSvcDesc%
ServiceType=1                       ; SERVICE_KERNEL_DRIVER
StartType=3                         ; SERVICE_DEMAND_START
ErrorControl=1                      ; SERVICE_ERROR_NORMAL
ServiceBinary=%12%\xhci98.sys
LoadOrderGroup=Base

[Xhci.CopyFiles]
xhci98.sys,,xhci98.tmp

[XhciMsi.AddService]
DisplayName=%XhciMsiSvcDesc%
ServiceType=1                       ; SERVICE_KERNEL_DRIVER
StartType=0                         ; SERVICE_BOOT_START
ErrorControl=1                      ; SERVICE_ERROR_NORMAL
ServiceBinary=%12%\xhcimsi.sys

[XhciMsi.CopyFiles]
xhcimsi.sys,,xhcimsi.tmp

; Message-signalled interrupts on Vista and 7 (design record 15 section
; 4.3, task 36.15): one message asked for in the controller's hardware key.
; NOCLOBBER keeps a user's MSISupported 0 - the way to force the line besides
; XhciInterruptMode 1 - across an update; the driver, not this limit, holds
; the delivery to Interrupter 0's one message.
[Xhci.Msi.AddReg]
HKR,"Interrupt Management",,0x00000010
HKR,"Interrupt Management\MessageSignaledInterruptProperties",,0x00000010
HKR,"Interrupt Management\MessageSignaledInterruptProperties",MSISupported,0x00010003,1
HKR,"Interrupt Management\MessageSignaledInterruptProperties",MessageNumberLimit,0x00010003,1

[Xhci.CopyOS]
usbd.sys,,,16

[Xhci.CopyUI]
usbui.dll,,,16

[Inf.CopyFiles]
xhci98.inf

[DefaultInstall]
CopyFiles=Inf.CopyFiles,Xhci.CopyFiles,Xhci.CopyOS,Xhci.CopyUI

[DefaultInstall.NTx86]
CopyFiles=Xhci.CopyFiles,Xhci.CopyOS,Xhci.CopyUI

[Strings]
Provider="Yeo Kheng Meng"
Mfg="xHCI98 Project"
DiskName="xhci98 xHCI Host Controller Disk"
XhciDesc="xHCI98 USB 3.x eXtensible Host Controller"
RootHubDesc="xHCI98 USB 3.x Root Hub"
HubDesc="xHCI98 USB Hub"
Hub30Desc="xHCI98 USB 3.x Hub"
CompositeDesc="xHCI98 USB Composite Device"
XhciSvcDesc="xHCI98 USB 3.x eXtensible Host Controller Driver (xhci98)"
XhciMsiSvcDesc="xHCI98 MSI helper for 32-bit Vista and 7 (xhcimsi)"
