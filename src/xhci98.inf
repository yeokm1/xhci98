; xhci98.inf - xHCI USB host controller miniport, the 32-bit package
;
; One file, two setup engines, one xhci98.sys. Windows 98 SE and Windows ME
; read only the undecorated sections and load the driver through
; *NTKERN/NTMPDriver. Windows 2000 and 32-bit XP read the .NTx86 sections and
; load it as a kernel service. 32-bit Vista and Windows 7 take the NT 6.x
; models section. scripts\inf-gate\check-inf.ps1 enforces the rules this file
; is built to satisfy; docs\contributing\build-and-test.md, "The INF must
; carry both install paths" and "Win98 INF-parser traps", explains them.
;
; ASCII only, CRLF line endings: Windows 98's 16-bit engine reports nothing at
; all for a file it cannot parse.
;
; usbport.sys is loaded through xhci98.sys's import, never as a service. On
; Windows 98 and ME the USB 2.0 stack (NUSB or SweetLow's) supplies it.

[Version]
Signature="$CHICAGO$"
Class=USB
ClassGUID={36FC9E60-C465-11CF-8056-444553540000}
Provider=%Provider%
; A CopyFiles entry not named in [SourceDisksFiles] is fetched from the OS's
; own install source through its layout.inf. This is how the OS-supplied files
; below arrive without being on this media.
LayoutFile=layout.inf
; Must equal src\xhci_version.h, where the version and date are edited. The
; INF gate and make-package.ps1 both check it. Windows 2000 ranks drivers by
; date then version, so an upgrade must move this forward.
DriverVer=09/18/2026,1.1.0.0

; NTx86.6.0 selects [XhciModels.NTx86.6.0] on Vista and Windows 7 only. This
; is the line Windows 98's engine parses to find [XhciModels]; add no other
; field (the gate refuses it, PATH-MFGDEC).
[Manufacturer]
%Mfg%=XhciModels,NTx86.6.0

; The xHCI class-code compatible ID, as the reference INFs use PCI\CC_0C0320
; for EHCI.
[XhciModels]
%XhciDesc%=Xhci.Dev,PCI\CC_0C0330

; A different install section name, not a .6.0 decoration on Xhci.Dev: the
; version decoration selects the models section only, so [Xhci.Dev.NTx86.6.0]
; would never be read.
[XhciModels.NTx86.6.0]
%XhciDesc%=Xhci.Dev6,PCI\CC_0C0330

[SourceDisksNames]
1=%DiskName%,xhci98.sys,,

; Only this project's files. Nothing Microsoft's goes on the media.
[SourceDisksFiles]
xhci98.sys=1
xhci98.inf=1

; Dirid 10 + System32\Drivers, never dirid 12, which on Windows 98 resolves to
; System\Iosubsys. Dirid 11 is for usbui.dll, a user-mode DLL, where each OS's
; own USB INF puts it.
[DestinationDirs]
DefaultDestDir=10
Xhci.CopyFiles=10,System32\Drivers
Xhci.CopyW98=10,System32\Drivers
Xhci.CopyNT=10,System32\Drivers
Xhci.CopyUI=11
Inf.CopyFiles=17

; ------------------------------------------------------------------
; Windows 98 SE and Windows ME (undecorated)
; ------------------------------------------------------------------

[Xhci.Dev]
AddReg=Xhci.AddReg
CopyFiles=Xhci.CopyFiles,Xhci.CopyW98,Xhci.CopyUI

; DevLoader and NTMPDriver load the driver, as NUSB's [EHCI.AddReg] does.
; EnumPropPages gives the controller its Advanced tab (sysclass.dll draws it;
; its Bandwidth Usage dialog needs usbui.dll, copied below).
; The registry values the driver reads are described at [Xhci.AddReg.NT].
[Xhci.AddReg]
HKR,,DevLoader,,*NTKERN
HKR,,NTMPDriver,,xhci98.sys
HKR,,EnumPropPages,,"sysclass.dll,USBControllerPropPage"
HKR,,XhciLogVerbosity,0x00010001,0
HKR,,XhciLogDebugView,0x00010001,0
HKR,,XhciImodInterval250ns,0x00010001,500

; ------------------------------------------------------------------
; Registry values, written on every install path
; ------------------------------------------------------------------
;
; All are DWORDs (0x00010001) in the device's software key, read by the driver
; at start through usbport's UsbPortGetMiniportRegistryKeyValue.
;
;   XhciLogVerbosity       0 off (the default), 1 counters, 2 adds the log,
;                          3 adds the port table, 4 adds kernel addresses.
;                          Out of range means 0. XHCISNAP sets it.
;   XhciLogDebugView       1 hands the log to DbgPrint when the driver stops
;                          or a start is refused.
;   XhciImodInterval250ns  the interrupt moderation interval, in 250 ns units
;                          (IMODI). 500 is 125 us. Absent, unreadable, or
;                          outside 10-4000 means 4000 (1 ms, the hardware
;                          reset value), substituted rather than clamped.
;
; EnumPropPages32 and Controller give the NT controller its Advanced tab,
; drawn by usbui.dll, as the NT references write them for EHCI. On Vista and
; Windows 7 the value is only read when the devnode is built: to test it,
; reinstall the package rather than adding it by hand.
[Xhci.AddReg.NT]
HKR,,XhciLogVerbosity,0x00010001,0
HKR,,XhciLogDebugView,0x00010001,0
HKR,,XhciImodInterval250ns,0x00010001,500
HKR,,EnumPropPages32,,"usbui.dll,USBControllerPropPageProvider"
HKR,,Controller,1,01

; ------------------------------------------------------------------
; Windows 2000 and 32-bit Windows XP (.NTx86)
; ------------------------------------------------------------------

[Xhci.Dev.NTx86]
AddReg=Xhci.AddReg.NT
CopyFiles=Xhci.CopyFiles,Xhci.CopyNT,Xhci.CopyUI

[Xhci.Dev.NTx86.Services]
AddService=xhci98,0x00000002,Xhci.AddService

; ------------------------------------------------------------------
; 32-bit Windows Vista and Windows 7
; ------------------------------------------------------------------
;
; xhci98.sys alone. The OS-supplied files are already on every install, and a
; LayoutFile copy aborts the NT 6.x file queue even with flag 16 (the gate
; refuses one here, OS-ONNT6). Right-click Install does not work on NT 6.x;
; use the device install.
[Xhci.Dev6.NTx86]
AddReg=Xhci.AddReg.NT
CopyFiles=Xhci.CopyFiles

[Xhci.Dev6.NTx86.Services]
AddService=xhci98,0x00000002,Xhci.AddService

[Xhci.AddService]
DisplayName=%XhciSvcDesc%
ServiceType=1                       ; SERVICE_KERNEL_DRIVER
StartType=3                         ; SERVICE_DEMAND_START
ErrorControl=1                      ; SERVICE_ERROR_NORMAL
ServiceBinary=%12%\xhci98.sys
LoadOrderGroup=Base

; ------------------------------------------------------------------
; File lists
; ------------------------------------------------------------------

; The third field is a temporary name, so Windows 98 can replace a loaded
; xhci98.sys. It may leave a harmless xhci98.tmp behind.
[Xhci.CopyFiles]
xhci98.sys,,xhci98.tmp

; OS-supplied files, fetched through LayoutFile from the OS's own source.
; An xHCI-only machine never had them placed. Flag 16 is COPYFLG_NO_OVERWRITE:
; a file already present is left alone whatever its version.
;
;   usbd.sys     imported by the USB 2.0 root hub driver.
;   usbhub.sys   Windows 98's composite parent; the NT hub driver.
;   usbport.sys  NT only; xhci98.sys imports it. On Windows 98 the USB 2.0
;                stack places it, and layout.inf has no row for it.
;
; usbhub20.sys is on neither path: Windows 2000 places it itself, and XP has
; no such file.
[Xhci.CopyW98]
usbd.sys,,,16
usbhub.sys,,,16

[Xhci.CopyNT]
usbport.sys,,,16
usbd.sys,,,16
usbhub.sys,,,16

; usbui.dll draws the controller's and root hub's property pages and dialogs.
; Same route and flag as above; dirid 11.
[Xhci.CopyUI]
usbui.dll,,,16

[Inf.CopyFiles]
xhci98.inf

; ------------------------------------------------------------------
; Right-click Install - pre-stages the files with no device present
; ------------------------------------------------------------------

[DefaultInstall]
CopyFiles=Inf.CopyFiles,Xhci.CopyFiles,Xhci.CopyW98,Xhci.CopyUI

; No Inf.CopyFiles: the NT engine keeps its own oemN.inf copy, and a second
; copy would leave two INFs claiming PCI\CC_0C0330.
[DefaultInstall.NTx86]
CopyFiles=Xhci.CopyFiles,Xhci.CopyNT,Xhci.CopyUI

; "USB 2.0" leads XhciDesc because only the USB 2.0 ports are driven, and
; "(xhci98)" tells it apart from Microsoft's entries. A changed string shows
; only on a fresh install.
[Strings]
Provider="Yeo Kheng Meng"
Mfg="xHCI98 Project"
DiskName="xhci98 xHCI Miniport Disk"
XhciDesc="USB 2.0 eXtensible Host Controller (xhci98)"
XhciSvcDesc="xHCI USB 2.0 Host Controller Miniport (xhci98)"
