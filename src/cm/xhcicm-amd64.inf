%Usb4Desc%=Cm.Dev,PCI\VEN_8086&DEV_4D33
%Usb4Desc%=Cm.Dev,PCI\VEN_8086&DEV_5781
%Usb4Desc%=Cm.Dev,PCI\VEN_8086&DEV_5784
%Usb4Desc%=Cm.Dev,PCI\VEN_1022&DEV_1668
%Usb4Desc%=Cm.Dev,PCI\VEN_1022&DEV_1669
%Usb4Desc%=Cm.Dev,PCI\CC_0C0340

