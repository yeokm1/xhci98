; xhcicmf.inf - xhcicm.sys as the upper filter of the Thunderbolt 3 tunnel
; bridge, the 32-bit package's NT-only filter INF (design record 21
; sections 3.2, 3.3 and 6.2, decision D2; roadmap-usb4.md task 39-A.1).
;
; NT targets only, by its signature: Windows 98 SE's and ME's engine ignores
; a "$Windows NT$" INF outright, which is what keeps this driver off every
; bridge there - a WDM driver on a bridge devnode breaks the bridge on
; Windows 98 (record 21 section 6.1). Windows 2000 and XP read the
; undecorated [CmFilterModels]; Vista and 7 the .NTx86.6.0 one. No INF of
; this driver that Windows 98 reads names a bridge (CM-NO9XBRIDGE).
;
; DRAFT, pending task 39-0.4, which reads the install route on the guests:
; the model lines are the Thunderbolt switches' port ids (each port of a
; switch carries its switch's id; the filter attaches to each and acts only
; on the one the NHI names), and the install sections keep pci.sys as the
; bridge's function driver by including and needing machine.inf's
; PCI-to-PCI bridge section, adding xhcicm as a device-specific
; UpperFilters value and its service. Which section name machine.inf gives
; the bridge on each target, and whether the vendor-id match outranks
; pci.inf's own install without displacing it, is what that reading
; settles. The lines and the two Include/Needs pairs are the only places
; that change. Every line must carry &CC_0604: the driver takes the filter
; role by that class (src\cm\cm_vals.c).
;
; The filter reads no registry value; the NHI's values are xhcicm.inf's.
;
; scripts\inf-gate\check-cm-inf.ps1 -Filter gates this file on every build.
;
; ASCII only, CRLF line endings.

[Version]
Signature="$Windows NT$"
Class=System
ClassGUID={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
; Must equal src\xhci_version.h.
DriverVer=10/14/2026,2.4.0.0

[Manufacturer]
%Mfg%=CmFilterModels,NTx86.6.0

[CmFilterModels]
; Record 21 section 3.3's list. The discrete controllers' switch ports;
; 15C0 has been read by this project, every other line is untested.
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_15C0&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_156B&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_156D&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_1576&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_1578&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_15D3&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_15DA&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_15E7&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_15EA&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_1133&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_1136&CC_0604
; The integrated controllers' tunnel root ports (Ice Lake to Raptor Lake),
; untested; the filter acts only on ports the NHI verifies and assigns.
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_8A1D&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_8A1F&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_8A21&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_8A23&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_9A23&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_9A25&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_9A27&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_9A29&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_9A2B&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_9A2D&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_9A2F&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_9A31&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_466E&CC_0604
%TunnelDesc%=CmF.Dev,PCI\VEN_8086&DEV_463F&CC_0604
