%TunnelDesc%=CmF.Dev6,PCI\VEN_8086&DEV_9A2D&CC_0604
%TunnelDesc%=CmF.Dev6,PCI\VEN_8086&DEV_9A2F&CC_0604
%TunnelDesc%=CmF.Dev6,PCI\VEN_8086&DEV_9A31&CC_0604
%TunnelDesc%=CmF.Dev6,PCI\VEN_8086&DEV_466E&CC_0604
%TunnelDesc%=CmF.Dev6,PCI\VEN_8086&DEV_463F&CC_0604
