[SourceDisksNames]
1=%DiskName%,xhcicm.sys,,

[SourceDisksFiles]
xhcicm.sys=1

[DestinationDirs]
DefaultDestDir=10
CmFilter.CopyFiles=10,System32\Drivers

; --- Windows 2000 and XP ----------------------------------------------------

[CmF.Dev.NTx86]
Include=machine.inf
Needs=PCI_DRV
CopyFiles=CmFilter.CopyFiles

[CmF.Dev.NTx86.HW]
Include=machine.inf
Needs=PCI_DRV.HW
AddReg=CmFilter.HW.AddReg

[CmF.Dev.NTx86.Services]
Include=machine.inf
Needs=PCI_DRV.Services
AddService=xhcicm,,CmFilter.AddService

; --- Windows Vista and 7 ----------------------------------------------------

[CmF.Dev6.NTx86]
Include=machine.inf
Needs=PCI_DRV
CopyFiles=CmFilter.CopyFiles

[CmF.Dev6.NTx86.HW]
Include=machine.inf
Needs=PCI_DRV.HW
AddReg=CmFilter.HW.AddReg

[CmF.Dev6.NTx86.Services]
Include=machine.inf
Needs=PCI_DRV.Services
AddService=xhcicm,,CmFilter.AddService

; --- Shared -----------------------------------------------------------------

; The bridge devnode's hardware key: this driver above pci.sys, by service
; name, as a device-specific filter (not a class filter), appended to the
; value (FLG_ADDREG_APPEND) so a filter already there is kept.
[CmFilter.HW.AddReg]
HKR,,UpperFilters,0x00010008,"xhcicm"

; The same service as the NHI's, demand-started with the devnode it filters.
[CmFilter.AddService]
DisplayName=%CmSvcDesc%
ServiceType=1                       ; SERVICE_KERNEL_DRIVER
StartType=3                         ; SERVICE_DEMAND_START
ErrorControl=1                      ; SERVICE_ERROR_NORMAL
ServiceBinary=%12%\xhcicm.sys
LoadOrderGroup=Base

[CmFilter.CopyFiles]
xhcicm.sys

