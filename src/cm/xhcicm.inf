%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_9A1B
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_9A1D
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_9A1F
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_9A21
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_463E
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_466D
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_A73E
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_A76D
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_7EB2
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_7EC2
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_7EC3
; The USB4 software connection manager's NHIs (Phase 40): until it lands
; the driver starts on them and does nothing (AMD's from FreeBSD's
; nhi_reg.h). Untested. The class line
; takes any USB4 NHI (class 0C/03/40); whether Windows 98's engine
; matches a PCI\CC_ id is unread.
%Usb4Desc%=Cm.Dev,PCI\VEN_8086&DEV_A833
%Usb4Desc%=Cm.Dev,PCI\VEN_8086&DEV_A834
%Usb4Desc%=Cm.Dev,PCI\VEN_8086&DEV_E333
%Usb4Desc%=Cm.Dev,PCI\VEN_8086&DEV_E334
%Usb4Desc%=Cm.Dev,PCI\VEN_8086&DEV_E433
%Usb4Desc%=Cm.Dev,PCI\VEN_8086&DEV_E434
%Usb4Desc%=Cm.Dev,PCI\VEN_8086&DEV_4D33
%Usb4Desc%=Cm.Dev,PCI\VEN_8086&DEV_5781
%Usb4Desc%=Cm.Dev,PCI\VEN_8086&DEV_5784
%Usb4Desc%=Cm.Dev,PCI\VEN_1022&DEV_1668
%Usb4Desc%=Cm.Dev,PCI\VEN_1022&DEV_1669
%Usb4Desc%=Cm.Dev,PCI\CC_0C0340

