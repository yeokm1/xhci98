; xhcicm.inf - the Thunderbolt and USB4 connection manager, xhcicm.sys
; (design records 21 and 22; roadmap-usb4.md tasks 39-A.1 and 40-0.2), on
; the Thunderbolt or USB4 NHI (the native host interface): the 32-bit
; package's NHI INF.
;
; It binds the driver as the NHI's function driver and never names a
; bridge: the tunnel ports' filter is installed by xhcicmf.inf, an NT-only
; file the package keeps in its nt\ subdirectory, out of the Windows 98
; engine's way, because Windows 2000 reads the undecorated models section
; this file shares with Windows 98 (record 21 section 3.3; the gate's
; CM-NO9XBRIDGE rule).
;
; The NHI ids: record 21 section 3.3's list (decision D9, owner 2026-10-15),
; every Intel firmware-connection-manager host Linux's drivers/thunderbolt
; addresses; and design record 22 section 3.7's USB4 hosts, the Intel ones
; with no firmware connection manager, AMD's Pink Sardine and the class
; line for any other. src\cm\cm_vals.c maps each id to its profile (the
; gate's CM-IDLIST). Only 15BF (Alpine Ridge LP, the ThinkPad P14s Gen 1's)
; has been read by this project; every other line is untested. A user who
; needs another id adds a model line to a copy of this file (record 21
; section 8, XhciCmMode 2).
;
; The description names the controller, never the connection manager that
; runs it: its generation (TB2, TB3 or USB4) and, on an id line, its maker
; and product, one string per product (Tb2FrDesc ... U4PsDesc); the class
; line's U4Desc is the plain xHCI98 USB4 Router (record 21 section 3.3,
; task 43.73; the gate's CM-DESC, and test_inst holds each string to
; xhciinst\inst_core.c's name table and 98 SE's 46-character limit).
;
; Three install paths, as xhci98.inf: Windows 98 SE and ME read the
; undecorated sections and load the driver through *NTKERN/NTMPDriver;
; Windows 2000 and XP read the .NTx86 sections and install a kernel
; service; Vista and 7 read the .NTx86.6.0 models section and its install
; sections. The driver needs no OS-supplied file, so there is no LayoutFile
; and every path copies the driver alone.
;
; Every registry value the driver reads (record 21 section 8, record 22
; section 12) is written by
; every install path at the driver's own default as a REG_DWORD under
; FLG_ADDREG_NOCLOBBER (0x00010003), so a value a user set survives a
; reinstall and a written default reads exactly as an absent one - except
; XhciCmTunnelBridge, whose absence is meaningful and which no INF writes.
; The two values the driver reads on Windows 98 SE and ME alone,
; XhciCmBridgeNumbering and XhciCmNoIrqStart, are written by the 98 SE and
; ME install alone (task 44.46).
;
; scripts\inf-gate\check-cm-inf.ps1 gates this file on every build.
;
; ASCII only, CRLF line endings.

[Version]
Signature="$CHICAGO$"
Class=System
ClassGUID={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
; Must equal src\xhci_version.h.
DriverVer=10/28/2026,3.3.0.0

[Manufacturer]
%Mfg%=CmModels,NTx86.6.0

[CmModels]
; Record 21 section 3.3's list: Intel's firmware connection manager hosts.
; 15BF has been read by this project; every other line is untested.
%Tb3ArDesc%=Cm.Dev,PCI\VEN_8086&DEV_15BF
%Tb2FrDesc%=Cm.Dev,PCI\VEN_8086&DEV_156A
%Tb2FrDesc%=Cm.Dev,PCI\VEN_8086&DEV_156C
%Tb3ArDesc%=Cm.Dev,PCI\VEN_8086&DEV_1575
%Tb3ArDesc%=Cm.Dev,PCI\VEN_8086&DEV_1577
%Tb3ArDesc%=Cm.Dev,PCI\VEN_8086&DEV_15D2
%Tb3ArDesc%=Cm.Dev,PCI\VEN_8086&DEV_15D9
%Tb3TrDesc%=Cm.Dev,PCI\VEN_8086&DEV_15E8
%Tb3TrDesc%=Cm.Dev,PCI\VEN_8086&DEV_15EB
%U4MrDesc%=Cm.Dev,PCI\VEN_8086&DEV_1134
%U4MrDesc%=Cm.Dev,PCI\VEN_8086&DEV_1137
%Tb3IlDesc%=Cm.Dev,PCI\VEN_8086&DEV_8A17
%Tb3IlDesc%=Cm.Dev,PCI\VEN_8086&DEV_8A0D
%U4TlDesc%=Cm.Dev,PCI\VEN_8086&DEV_9A1B
%U4TlDesc%=Cm.Dev,PCI\VEN_8086&DEV_9A1D
%U4TlDesc%=Cm.Dev,PCI\VEN_8086&DEV_9A1F
%U4TlDesc%=Cm.Dev,PCI\VEN_8086&DEV_9A21
%U4AdDesc%=Cm.Dev,PCI\VEN_8086&DEV_463E
%U4AdDesc%=Cm.Dev,PCI\VEN_8086&DEV_466D
%U4RlDesc%=Cm.Dev,PCI\VEN_8086&DEV_A73E
%U4RlDesc%=Cm.Dev,PCI\VEN_8086&DEV_A76D
%U4MlDesc%=Cm.Dev,PCI\VEN_8086&DEV_7EB2
%U4MlDesc%=Cm.Dev,PCI\VEN_8086&DEV_7EC2
%U4MlDesc%=Cm.Dev,PCI\VEN_8086&DEV_7EC3
; Design record 22 section 3.7: the USB4 software connection manager's
; hosts (Phase 40), INERT until its driver half lands. Lunar, Panther and
; Wildcat Lake and Barlow Ridge by id, AMD's Pink Sardine named beside the
; class line, and any other USB4 host (class 0C/03/40) by the class line,
; which the id lines outrank. All untested.
%U4LnDesc%=Cm.Dev,PCI\VEN_8086&DEV_A833
%U4LnDesc%=Cm.Dev,PCI\VEN_8086&DEV_A834
%U4PlDesc%=Cm.Dev,PCI\VEN_8086&DEV_E333
%U4PlDesc%=Cm.Dev,PCI\VEN_8086&DEV_E334
%U4PlDesc%=Cm.Dev,PCI\VEN_8086&DEV_E433
%U4PlDesc%=Cm.Dev,PCI\VEN_8086&DEV_E434
%U4WlDesc%=Cm.Dev,PCI\VEN_8086&DEV_4D33
%U4BrDesc%=Cm.Dev,PCI\VEN_8086&DEV_5781
%U4BrDesc%=Cm.Dev,PCI\VEN_8086&DEV_5784
%U4PsDesc%=Cm.Dev,PCI\VEN_1022&DEV_1668
%U4PsDesc%=Cm.Dev,PCI\VEN_1022&DEV_1669
%U4Desc%=Cm.Dev,PCI\CC_0C0340

[CmModels.NTx86.6.0]
; Record 21 section 3.3's list: Intel's firmware connection manager hosts.
; 15BF has been read by this project; every other line is untested.
%Tb3ArDesc%=Cm.Dev6,PCI\VEN_8086&DEV_15BF
%Tb2FrDesc%=Cm.Dev6,PCI\VEN_8086&DEV_156A
%Tb2FrDesc%=Cm.Dev6,PCI\VEN_8086&DEV_156C
%Tb3ArDesc%=Cm.Dev6,PCI\VEN_8086&DEV_1575
%Tb3ArDesc%=Cm.Dev6,PCI\VEN_8086&DEV_1577
%Tb3ArDesc%=Cm.Dev6,PCI\VEN_8086&DEV_15D2
%Tb3ArDesc%=Cm.Dev6,PCI\VEN_8086&DEV_15D9
%Tb3TrDesc%=Cm.Dev6,PCI\VEN_8086&DEV_15E8
%Tb3TrDesc%=Cm.Dev6,PCI\VEN_8086&DEV_15EB
%U4MrDesc%=Cm.Dev6,PCI\VEN_8086&DEV_1134
%U4MrDesc%=Cm.Dev6,PCI\VEN_8086&DEV_1137
%Tb3IlDesc%=Cm.Dev6,PCI\VEN_8086&DEV_8A17
%Tb3IlDesc%=Cm.Dev6,PCI\VEN_8086&DEV_8A0D
%U4TlDesc%=Cm.Dev6,PCI\VEN_8086&DEV_9A1B
%U4TlDesc%=Cm.Dev6,PCI\VEN_8086&DEV_9A1D
%U4TlDesc%=Cm.Dev6,PCI\VEN_8086&DEV_9A1F
%U4TlDesc%=Cm.Dev6,PCI\VEN_8086&DEV_9A21
%U4AdDesc%=Cm.Dev6,PCI\VEN_8086&DEV_463E
%U4AdDesc%=Cm.Dev6,PCI\VEN_8086&DEV_466D
%U4RlDesc%=Cm.Dev6,PCI\VEN_8086&DEV_A73E
%U4RlDesc%=Cm.Dev6,PCI\VEN_8086&DEV_A76D
%U4MlDesc%=Cm.Dev6,PCI\VEN_8086&DEV_7EB2
%U4MlDesc%=Cm.Dev6,PCI\VEN_8086&DEV_7EC2
%U4MlDesc%=Cm.Dev6,PCI\VEN_8086&DEV_7EC3
; Design record 22 section 3.7: the USB4 software connection manager's
; hosts (Phase 40), INERT until its driver half lands. Lunar, Panther and
; Wildcat Lake and Barlow Ridge by id, AMD's Pink Sardine named beside the
; class line, and any other USB4 host (class 0C/03/40) by the class line,
; which the id lines outrank. All untested.
%U4LnDesc%=Cm.Dev6,PCI\VEN_8086&DEV_A833
%U4LnDesc%=Cm.Dev6,PCI\VEN_8086&DEV_A834
%U4PlDesc%=Cm.Dev6,PCI\VEN_8086&DEV_E333
%U4PlDesc%=Cm.Dev6,PCI\VEN_8086&DEV_E334
%U4PlDesc%=Cm.Dev6,PCI\VEN_8086&DEV_E433
%U4PlDesc%=Cm.Dev6,PCI\VEN_8086&DEV_E434
%U4WlDesc%=Cm.Dev6,PCI\VEN_8086&DEV_4D33
%U4BrDesc%=Cm.Dev6,PCI\VEN_8086&DEV_5781
%U4BrDesc%=Cm.Dev6,PCI\VEN_8086&DEV_5784
%U4PsDesc%=Cm.Dev6,PCI\VEN_1022&DEV_1668
%U4PsDesc%=Cm.Dev6,PCI\VEN_1022&DEV_1669
%U4Desc%=Cm.Dev6,PCI\CC_0C0340

[SourceDisksNames]
1=%DiskName%,xhcicm.sys,,

[SourceDisksFiles]
xhcicm.sys=1
xhcicm.inf=1

[DestinationDirs]
DefaultDestDir=10
Cm.CopyFiles=10,System32\Drivers
Inf.CopyFiles=17

; --- Windows 98 SE and ME ---------------------------------------------------

[Cm.Dev]
AddReg=Cm.AddReg,Cm.Values,Cm.Values9x
CopyFiles=Cm.CopyFiles

[Cm.AddReg]
HKR,,DevLoader,,*NTKERN
HKR,,NTMPDriver,,xhcicm.sys

; --- Windows 2000 and XP ----------------------------------------------------

[Cm.Dev.NTx86]
AddReg=Cm.Values
CopyFiles=Cm.CopyFiles

[Cm.Dev.NTx86.Services]
AddService=xhcicm,0x00000002,Cm.AddService

; --- Windows Vista and 7 ----------------------------------------------------

[Cm.Dev6.NTx86]
AddReg=Cm.Values
CopyFiles=Cm.CopyFiles

[Cm.Dev6.NTx86.Services]
AddService=xhcicm,0x00000002,Cm.AddService

; --- Shared -----------------------------------------------------------------

; The driver's values (record 21 section 8, record 22 section 12), each at the driver's default.
; XhciCmTunnelBridge is not written: its absence means no override.
[Cm.Values]
HKR,,XhciCmMode,0x00010003,1
HKR,,XhciCmApprove,0x00010003,1
HKR,,XhciCmReenum,0x00010003,1
HKR,,XhciCmPollIdleMs,0x00010003,200
HKR,,XhciCmCmdTimeoutMs,0x00010003,5000
HKR,,XhciCmApproveTimeoutMs,0x00010003,10000
HKR,,XhciCmSafeEject,0x00010003,1
HKR,,XhciCmLogVerbosity,0x00010003,2
; The USB4 profile's (design record 22 section 12).
HKR,,XhciCmUsb3Tunnel,0x00010003,1
HKR,,XhciCmLaneBonding,0x00010003,1
HKR,,XhciCmPreOsCleanup,0x00010003,0
; The log's emission (record 21 section 8): 1 prints it to a debugger.
HKR,,XhciCmLogDebugView,0x00010003,0

; The values the driver reads on Windows 98 SE and ME alone (record 21
; section 8; task 44.46), written by their install alone, each at the
; driver's default: the set-up of the bridges a tunnel brings up after the
; start (record 21 section 6.1.1) and the start of an NVMe drive whose
; interrupt cannot be routed (design record 28 section 7).
[Cm.Values9x]
HKR,,XhciCmBridgeNumbering,0x00010003,1
HKR,,XhciCmNoIrqStart,0x00010003,1

[Cm.AddService]
DisplayName=%CmSvcDesc%
ServiceType=1                       ; SERVICE_KERNEL_DRIVER
StartType=3                         ; SERVICE_DEMAND_START
ErrorControl=1                      ; SERVICE_ERROR_NORMAL
ServiceBinary=%12%\xhcicm.sys
LoadOrderGroup=Base

; No temporary-file field, as xhciuas.inf: at a first install this driver is
; not loaded, and Windows 98 would route the copy through WININIT.INI and a
; restart.
[Cm.CopyFiles]
xhcicm.sys

[Inf.CopyFiles]
xhcicm.inf

; Right-click Install pre-stages the driver with no device present.
[DefaultInstall]
CopyFiles=Inf.CopyFiles,Cm.CopyFiles

[DefaultInstall.NTx86]
CopyFiles=Cm.CopyFiles

[Strings]
Provider="Yeo Kheng Meng"
Mfg="xHCI98 Project"
DiskName="xhci98 xHCI Host Controller Disk"
