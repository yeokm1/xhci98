[SourceDisksNames]
1=%DiskName%,xhcicm.sys,,

[SourceDisksFiles]
xhcicm.sys=1
xhcihlpr.sys=1
xhcicm.inf=1

[DestinationDirs]
DefaultDestDir=10
Cm.CopyFiles=10,System32\Drivers
XhciHlpr.CopyFiles=10,System32\Drivers
Inf.CopyFiles=17

; --- Windows 98 SE and ME ---------------------------------------------------

[Cm.Dev]
AddReg=Cm.AddReg,Cm.Values,Cm.Values9x
CopyFiles=Cm.CopyFiles

[Cm.AddReg]
HKR,,DevLoader,,*NTKERN
HKR,,NTMPDriver,,xhcicm.sys

; --- Windows 2000 and XP ----------------------------------------------------

; The helper starts at the next boot (boot start); no Reboot here: Setup
; asks for the restart, and a device installed by hand sends the handover
; from the next start (design record 18 section 15.15).
[Cm.Dev.NTx86]
AddReg=Cm.Values,Cm.ValuesNt,Cm.ValuesNt5
CopyFiles=Cm.CopyFiles,XhciHlpr.CopyFiles

[Cm.Dev.NTx86.Services]
AddService=xhcicm,0x00000002,Cm.AddService
AddService=xhcihlpr,,XhciHlpr.AddService

; --- Windows Vista and 7 ----------------------------------------------------

[Cm.Dev6.NTx86]
AddReg=Cm.Values,Cm.ValuesNt
CopyFiles=Cm.CopyFiles,XhciHlpr.CopyFiles

[Cm.Dev6.NTx86.Services]
AddService=xhcicm,0x00000002,Cm.AddService
AddService=xhcihlpr,,XhciHlpr.AddService

; --- Shared -----------------------------------------------------------------

; The driver's values (record 21 section 8, record 22 section 12), each at
; the driver's default.
[Cm.Values]
HKR,,XhciCmMode,0x00010003,1
HKR,,XhciCmApprove,0x00010003,1
HKR,,XhciCmReenum,0x00010003,1
HKR,,XhciCmPollIdleMs,0x00010003,200
HKR,,XhciCmCmdTimeoutMs,0x00010003,5000
HKR,,XhciCmApproveTimeoutMs,0x00010003,10000
HKR,,XhciCmSafeEject,0x00010003,1
HKR,,XhciCmLogVerbosity,0x00010003,2
; The USB4 profile's (design record 22 section 12).
HKR,,XhciCmUsb3Tunnel,0x00010003,1
HKR,,XhciCmLaneBonding,0x00010003,1
HKR,,XhciCmPreOsCleanup,0x00010003,0
; The log's emission (record 21 section 8): 1 prints it to a debugger.
HKR,,XhciCmLogDebugView,0x00010003,0
; Thunderbolt networking (design record 35 section 8.1, task 45.59): off
; until the installer's networking box or /tbnet writes XhciCmNet 1.
HKR,,XhciCmNet,0x00010003,0
HKR,,XhciCmNetPollMs,0x00010003,1
HKR,,XhciCmNetRxFrames,0x00010003,128
HKR,,XhciCmNetTxFrames,0x00010003,128
HKR,,XhciCmNetE2E,0x00010003,1
; Record 35 section 5.5 (task 48.38): the data ring's interrupt, where
; XhciCmRingInterrupt's is connected and proven; 0 keeps the poll alone.
HKR,,XhciCmNetInterrupt,0x00010003,1
; Record 22 section 7.6.2 (task 48.43): 1 lets an eject close the PCIe
; tunnel of a device attached at start on a host that does not map its
; ports, by an inferred port cross-checked twice; 0 never infers.
HKR,,XhciCmInferAtStart,0x00010003,0
; Written since task 45.50 (record 21 section 8.1), each at the driver's
; default: the tunnel ports' override, whose "auto" is the driver's own
; finding (a REG_SZ; a list of bb:dd.f bridges replaces it), the ASM4242
; credits experiment (record 22 section 18.8), the USB4 version 2 switch
; (record 22 section 12) and, since task 45.56, its Gen 4 Link Recovery
; switch (record 22 section 6.2.3 item 4).
HKR,,XhciCmTunnelBridge,0x00000002,"auto"
HKR,,XhciCmAsmediaPcie7Credits,0x00010003,0
HKR,,XhciCmUsb4V2,0x00010003,1
HKR,,XhciCmGen4LinkRecovery,0x00010003,1
HKR,,XhciCmSleepEntry,0x00010003,1
; The platform's USB4 handover on an ASM4242 (design record 32 sections
; 12.8.6, 12.8.15.10 and 12.8.15.17, task 46.12): its master switch and
; the structural tier, read on every system (on 2000 to 10 the tier
; applies to the read path alone).
HKR,,XhciCmAsm4242Handover,0x00010003,1
HKR,,XhciCmAsm4242Structural,0x00010003,0
; The NHI's interrupt (record 21 section 4.5), read on every system since
; task 48.26 (on 2000 to 10 alone before, written by the NT paths alone).
HKR,,XhciCmRingInterrupt,0x00010003,0

; Task 45.50: the values the driver uses on Windows 2000 to 10 alone, written
; by their install paths alone.
[Cm.ValuesNt]
; Task 46.12 (record 32 section 12.8.15.12): the read path's opt-in for an
; ASM4242 board no profile knows, read on NT alone.
HKR,,XhciCmAsm4242Reads,0x00010003,0

; Task 45.50: the values the driver reads on Windows 2000 and XP (and XP
; x64) alone, written by their install paths alone: the bridges' memory
; windows set at a hot plug (design record 33 section 9.1).
[Cm.ValuesNt5]
HKR,,XhciCmBridgeReq,0x00010003,1

; The values the driver reads on Windows 98 SE and ME alone (record 21
; section 8; task 44.46), written by their install alone, each at the
; driver's default: the set-up of the bridges a tunnel brings up after the
; start (record 21 section 6.1.1) and the start of an NVMe drive whose
; interrupt cannot be routed (design record 28 section 7).
[Cm.Values9x]
HKR,,XhciCmBridgeNumbering,0x00010003,1
HKR,,XhciCmNoIrqStart,0x00010003,1

[Cm.AddService]
DisplayName=%CmSvcDesc%
ServiceType=1                       ; SERVICE_KERNEL_DRIVER
StartType=3                         ; SERVICE_DEMAND_START
ErrorControl=1                      ; SERVICE_ERROR_NORMAL
ServiceBinary=%12%\xhcicm.sys
LoadOrderGroup=Base

; No temporary-file field, as xhciuas.inf: at a first install this driver is
; not loaded, and Windows 98 would route the copy through WININIT.INI and a
; restart.
[Cm.CopyFiles]
xhcicm.sys

; xhci98.inf's helper service, the same in every directive (the gate's
; CM-HLPR); COPYFLG_NO_VERSION_DIALOG (0x20): a newer helper already in
; place is kept.
[XhciHlpr.AddService]
DisplayName=%XhciHlprSvcDesc%
ServiceType=1                       ; SERVICE_KERNEL_DRIVER
StartType=0                         ; SERVICE_BOOT_START
ErrorControl=1                      ; SERVICE_ERROR_NORMAL
ServiceBinary=%12%\xhcihlpr.sys

[XhciHlpr.CopyFiles]
xhcihlpr.sys,,,0x00000020

[Inf.CopyFiles]
xhcicm.inf

; Right-click Install pre-stages the driver with no device present.
[DefaultInstall]
CopyFiles=Inf.CopyFiles,Cm.CopyFiles

[DefaultInstall.NTx86]
CopyFiles=Cm.CopyFiles

