%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_15E8
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_15EB
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_1134
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_1137
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_8A17
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_8A0D
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_9A1B
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_9A1D
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_9A1F
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_9A21
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_463E
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_466D
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_A73E
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_A76D
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_7EB2
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_7EC2
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_7EC3
; Design record 22 section 3.7: the USB4 software connection manager's
; hosts (Phase 40), INERT until its driver half lands. Lunar, Panther and
; Wildcat Lake and Barlow Ridge by id, AMD's Pink Sardine named beside the
; class line, and any other USB4 host (class 0C/03/40) by the class line,
; which the id lines outrank. All untested.
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_A833
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_A834
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_E333
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_E334
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_E433
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_E434
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_4D33
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_5781
%U4Desc%=Cm.Dev,PCI\VEN_8086&DEV_5784
%U4Desc%=Cm.Dev,PCI\VEN_1022&DEV_1668
%U4Desc%=Cm.Dev,PCI\VEN_1022&DEV_1669
%U4Desc%=Cm.Dev,PCI\CC_0C0340

