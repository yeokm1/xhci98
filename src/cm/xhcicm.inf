; xhcicm.inf - the Thunderbolt 3 connection manager, xhcicm.sys (design
; record 21; roadmap-usb4.md task 39-A.1), on the Thunderbolt NHI (the
; native host interface): the 32-bit package's NHI INF.
;
; It binds the driver as the NHI's function driver and never names a
; bridge: the tunnel bridge's filter is installed by xhcicmf.inf, an NT-only
; file Windows 98's engine ignores by its signature, because Windows 2000
; reads the undecorated models section this file shares with Windows 98
; (record 21 section 3.3; the gate's CM-NO9XBRIDGE rule).
;
; The NHI ids are record 21 section 3.3's list (decision D9, owner
; 2026-10-15): every Intel firmware-connection-manager host Linux's
; drivers/thunderbolt addresses; src\cm\cm_vals.c maps each to its
; profile. Only 15BF (Alpine Ridge LP, the ThinkPad P14s Gen 1's) has been
; read by this project; every other line is untested. The hosts with no
; firmware connection manager (class 0C0340) are Phase 40's and not here.
; A user who needs another id adds a model line to a copy of this file
; (record 21 section 8, XhciCmMode 2).
;
; Three install paths, as xhci98.inf: Windows 98 SE and ME read the
; undecorated sections and load the driver through *NTKERN/NTMPDriver;
; Windows 2000 and XP read the .NTx86 sections and install a kernel
; service; Vista and 7 read the .NTx86.6.0 models section and its install
; sections. The driver needs no OS-supplied file, so there is no LayoutFile
; and every path copies the driver alone.
;
; Every registry value the driver reads (record 21 section 8) is written by
; every install path at the driver's own default as a REG_DWORD under
; FLG_ADDREG_NOCLOBBER (0x00010003), so a value a user set survives a
; reinstall and a written default reads exactly as an absent one - except
; XhciCmTunnelBridge, whose absence is meaningful and which no INF writes.
;
; scripts\inf-gate\check-cm-inf.ps1 gates this file on every build.
;
; ASCII only, CRLF line endings.

[Version]
Signature="$CHICAGO$"
Class=System
ClassGUID={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
; Must equal src\xhci_version.h.
DriverVer=10/14/2026,2.4.0.0

[Manufacturer]
%Mfg%=CmModels,NTx86.6.0

[CmModels]
; Record 21 section 3.3's list: Intel's firmware connection manager hosts.
; 15BF has been read by this project; every other line is untested.
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_15BF
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_156A
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_156C
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_1575
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_1577
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_15D2
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_15D9
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_15E8
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_15EB
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_1134
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_1137
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_8A17
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_8A0D
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_9A1B
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_9A1D
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_9A1F
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_9A21
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_463E
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_466D
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_A73E
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_A76D
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_7EB2
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_7EC2
%NhiDesc%=Cm.Dev,PCI\VEN_8086&DEV_7EC3

[CmModels.NTx86.6.0]
; Record 21 section 3.3's list: Intel's firmware connection manager hosts.
; 15BF has been read by this project; every other line is untested.
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_15BF
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_156A
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_156C
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_1575
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_1577
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_15D2
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_15D9
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_15E8
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_15EB
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_1134
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_1137
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_8A17
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_8A0D
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_9A1B
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_9A1D
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_9A1F
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_9A21
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_463E
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_466D
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_A73E
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_A76D
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_7EB2
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_7EC2
%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_7EC3

[SourceDisksNames]
1=%DiskName%,xhcicm.sys,,

[SourceDisksFiles]
xhcicm.sys=1
xhcicm.inf=1

[DestinationDirs]
DefaultDestDir=10
Cm.CopyFiles=10,System32\Drivers
Inf.CopyFiles=17

; --- Windows 98 SE and ME ---------------------------------------------------

[Cm.Dev]
AddReg=Cm.AddReg,Cm.Values
CopyFiles=Cm.CopyFiles

[Cm.AddReg]
HKR,,DevLoader,,*NTKERN
HKR,,NTMPDriver,,xhcicm.sys

; --- Windows 2000 and XP ----------------------------------------------------

[Cm.Dev.NTx86]
AddReg=Cm.Values
CopyFiles=Cm.CopyFiles

[Cm.Dev.NTx86.Services]
AddService=xhcicm,0x00000002,Cm.AddService

; --- Windows Vista and 7 ----------------------------------------------------

[Cm.Dev6.NTx86]
AddReg=Cm.Values
CopyFiles=Cm.CopyFiles

[Cm.Dev6.NTx86.Services]
AddService=xhcicm,0x00000002,Cm.AddService

; --- Shared -----------------------------------------------------------------

; The driver's values (record 21 section 8), each at the driver's default.
; XhciCmTunnelBridge is not written: its absence means no override.
[Cm.Values]
HKR,,XhciCmMode,0x00010003,1
HKR,,XhciCmApprove,0x00010003,1
HKR,,XhciCmReenum,0x00010003,1
HKR,,XhciCmPollIdleMs,0x00010003,200
HKR,,XhciCmCmdTimeoutMs,0x00010003,5000
HKR,,XhciCmApproveTimeoutMs,0x00010003,10000
HKR,,XhciCmSafeEject,0x00010003,1
HKR,,XhciLogVerbosity,0x00010003,0

[Cm.AddService]
DisplayName=%CmSvcDesc%
ServiceType=1                       ; SERVICE_KERNEL_DRIVER
StartType=3                         ; SERVICE_DEMAND_START
ErrorControl=1                      ; SERVICE_ERROR_NORMAL
ServiceBinary=%12%\xhcicm.sys
LoadOrderGroup=Base

; No temporary-file field, as xhciuas.inf: at a first install this driver is
; not loaded, and Windows 98 would route the copy through WININIT.INI and a
; restart.
[Cm.CopyFiles]
xhcicm.sys

[Inf.CopyFiles]
xhcicm.inf

; Right-click Install pre-stages the driver with no device present.
[DefaultInstall]
CopyFiles=Inf.CopyFiles,Cm.CopyFiles

[DefaultInstall.NTx86]
CopyFiles=Cm.CopyFiles

[Strings]
Provider="Yeo Kheng Meng"
Mfg="xHCI98 Project"
DiskName="xhci98 xHCI Host Controller Disk"
NhiDesc="xHCI98 Thunderbolt 3 Host Interface"
CmSvcDesc="xHCI98 Thunderbolt 3 Connection Manager (xhcicm)"
