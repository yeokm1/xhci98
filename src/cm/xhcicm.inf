%NhiDesc%=Cm.Dev6,PCI\VEN_8086&DEV_8A0D
%U4Desc%=Cm.Dev6,PCI\VEN_8086&DEV_9A1B
%U4Desc%=Cm.Dev6,PCI\VEN_8086&DEV_9A1D
