# txtsetup-amd64.oem - the text-mode Setup driver description for xhci98.sys,
# the 64-bit package: Windows XP x64 and Server 2003 x64 (roadmap-hcd.md task
# 33.3; design record 13, section 5.6). Staged as txtsetup.oem.
#
# At the start of text-mode Setup, press F6, then S at the "Setup could not
# determine the type of one or more mass storage devices" screen, and give
# Setup this disk in drive A:. Setup loads xhci98.sys as a "scsi" component,
# the one class F6 offers, and binds it by the ids below: the xHCI
# controller's PCI class code, the root hub the driver creates under a
# project-owned id, and the external hubs it presents under two more
# (XHCI98\HUB, XHCI98\HUB30; task 33.4). The devices behind the root hub are then bound by Setup's
# own HID and storage drivers (hidusb, kbdhid, mouhid, usbstor) through
# txtsetup.sif's own hardware-id table, with usbd.sys, hidclass.sys and
# hidparse.sys loaded from Setup's own source; none of them is on this disk.
#
# The 32-bit package's file is src\txtsetup.oem;
# scripts\inf-gate\check-txtsetup-oem.ps1 gates both and holds their sections
# equal outside the two description strings.
#
# ASCII only, CRLF line endings.

[Disks]
d1 = "xHCI98 USB 3.x Driver Disk (x64)", \xhci98.sys, \

[Defaults]
scsi = XHCI98

[scsi]
XHCI98 = "xHCI98 USB 3.x Host Controller (Windows XP x64)"

[Files.scsi.XHCI98]
driver = d1, xhci98.sys, xhci98
inf    = d1, xhci98.inf

[HardwareIds.scsi.XHCI98]
id = "PCI\CC_0C0330", "xhci98"
id = "XHCI98\ROOT_HUB", "xhci98"
id = "XHCI98\HUB", "xhci98"
id = "XHCI98\HUB30", "xhci98"
